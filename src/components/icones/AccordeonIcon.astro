---
/*
 * « Plus » dans une pastille : l'icône qui déploie un volet d'accordéon
 * (SVG en ligne de la description des icônes d'accessibilite-web dans
 * coquille-web). La pastille garde le bleu 200 de la source ; le signe prend
 * la couleur demandée, bleu principal par défaut.
 */
import IconeSvg from './IconeSvg.astro'

const { color = 'var(--bleu-principal)', ...props } = Astro.props
---

<IconeSvg viewBox="0 0 36 36" color={color} {...props}>
  <rect width="35" height="35" x=".5" y=".5" rx="17.5" fill="var(--bleu-200)"></rect>
  <path d="M24.213 18.35a.547.547 0 0 1-.547.547h-5.469v5.47a.547.547 0 1 1-1.094 0v-5.47h-5.469a.547.547 0 0 1 0-1.093h5.47v-5.469a.547.547 0 1 1 1.093 0v5.469h5.469a.547.547 0 0 1 .547.547Z"></path>
</IconeSvg>
