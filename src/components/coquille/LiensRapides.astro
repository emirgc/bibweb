---
/*
 * Liens rapides (QuickLinks.jsx et LibChatWidget.jsx de coquille-web).
 *
 * - ≥ 900 px : barre bleue verticale fixée à droite, repliée (seules les
 *   icônes restent visibles) ; elle se déplie au survol (≥ 1200 px, comme
 *   dans la source) et, ajout, dès qu'un de ses liens reçoit le focus.
 *   Changements par rapport à la source, qui recouvrait du contenu (le
 *   bouton « Suivant » de Carousel1, le texte des Sections) :
 *   · repliée dès le chargement : la source l'affichait dépliée (environ
 *     300 px) pendant 3 s ou jusqu'au premier défilement, puis la repliait
 *     d'elle-même ; ce mouvement automatique masquait le haut de la page ;
 *   · languette de 40 px au lieu de 65 : elle tient dans la plus petite
 *     marge latérale du contenu (40 px des Sections entre 900 et 1199 px,
 *     64 px de gouttière au-delà). Réserver la place à droite aurait coupé
 *     les fonds pleine largeur et rétréci l'en-tête ; la déplacer dans
 *     l'en-tête ou le pied de page l'aurait éloignée du contenu.
 * - < 900 px : barre fixe au bas de l'écran, icônes seules avec un nom
 *   accessible. Le corps de page réserve sa hauteur (padding-bottom) et
 *   scroll-padding-bottom écarte le focus de dessous la barre (WCAG 2.4.11).
 *   Elle couvrait le bas du texte pendant la lecture : elle glisse hors de
 *   l'écran au défilement vers le bas et revient au défilement vers le haut,
 *   en haut et en bas de la page, et dès qu'un de ses liens reçoit le focus
 *   (:focus-within). Mouvement réduit : apparition et retrait sans transition
 *   (règle globale). Sans JS, elle reste affichée.
 *
 * Placé après <main> dans Base.astro : barre et languette sont fixes, leur
 * place dans le DOM ne change que l'ordre de tabulation (en-tête, fil
 * d'Ariane, contenu, liens rapides, pied de page ; WCAG 2.4.3).
 *
 * « Clavarder » est un bouton (la source utilisait un lien vers « # ») qui
 * ouvre la fenêtre LibChat ; le script LibChat est chargé une seule fois.
 */
import { ChatsIcon } from '@phosphor-icons/react/dist/ssr/Chats'
import SofiaIcon from '@/components/icones/SofiaIcon.astro'
import { LIENS_RAPIDES as LIENS } from '@/data/navigation'

const LIBCHAT_HASH = '71ff3bc4ca990e9e993a02e35e2f804aa581c52535e870359e707314a83afdd3'
---

<div class="liens-rapides-bureau" data-liens-rapides>
  <nav class="panneau" aria-label="Liens rapides">
    <ul>
      {
        LIENS.map(({ libelle, href, Icone, nouvelOngletBureau }) => (
          <li>
            <a href={href} {...(nouvelOngletBureau ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="icone">{Icone ? <Icone size={24} aria-hidden="true" /> : <SofiaIcon size={24} />}</span>
              <span class="libelle">
                {libelle}
                {nouvelOngletBureau && <span class="visuellement-masque"> (nouvel onglet)</span>}
              </span>
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" data-clavarder>
          <span class="icone"><ChatsIcon size={24} aria-hidden="true" /></span>
          <span class="libelle">Clavarder</span>
        </button>
      </li>
    </ul>
  </nav>
</div>

<nav class="liens-rapides-mobile" aria-label="Liens rapides" data-liens-rapides-mobile>
  <ul>
    {
      LIENS.map(({ libelle, court, href, Icone }) => (
        <li>
          <a href={href} aria-label={libelle}>
            {Icone ? <Icone size={26} aria-hidden="true" /> : <SofiaIcon size={26} />}
            <span class="etiquette" aria-hidden="true">{court}</span>
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" aria-label="Clavarder" data-clavarder>
        <ChatsIcon size={26} aria-hidden="true" />
        <span class="etiquette" aria-hidden="true">Clavarder</span>
      </button>
    </li>
  </ul>
</nav>

<div id={`libchat_${LIBCHAT_HASH}`} class="libchat"></div>

<script define:vars={{ LIBCHAT_HASH }} is:inline>
  // Chargement de LibChat (LibChatWidget.jsx) : son bouton flottant est
  // masqué, la fenêtre s'ouvre depuis « Clavarder ».
  ;(() => {
    if (document.getElementById('libchat-script')) return
    const style = document.createElement('style')
    style.textContent = '.s-lch-widget-float-btn{display:none!important;opacity:0!important;pointer-events:none!important;visibility:hidden!important}'
    document.head.appendChild(style)
    const script = document.createElement('script')
    script.id = 'libchat-script'
    script.src = `https://unequestion.bib.umontreal.ca/load_chat.php?hash=${LIBCHAT_HASH}`
    script.async = true
    script.onload = () => (window.libChatLoaded = true)
    script.onerror = () => (window.libChatLoaded = false)
    document.body.appendChild(script)

    window.openLibChatDirect = () => {
      if (!window.libChatLoaded) {
        alert('Le service de clavardage est temporairement indisponible.')
        return
      }
      const bouton = document.querySelector('.s-lch-widget-float-btn')
      const boite = document.querySelector('.s-lch-widget-float')
      if (bouton) {
        bouton.style.opacity = '0'
        bouton.style.pointerEvents = 'none'
        bouton.style.visibility = 'hidden'
        bouton.click()
      }
      if (boite) boite.style.zIndex = '99999'
    }
  })()
</script>

<script>
  document.addEventListener('click', (e) => {
    if (!(e.target as Element | null)?.closest?.('[data-clavarder]')) return
    ;(window as unknown as { openLibChatDirect?: () => void }).openLibChatDirect?.()
  })

  // Barre mobile masquée au défilement vers le bas (voir l'en-tête). Le CSS
  // n'applique data-masquee que sous 900 px : rien à décider ici selon la
  // largeur. SEUIL évite qu'un petit rebond du défilement la fasse clignoter.
  const SEUIL = 8
  const barre = document.querySelector<HTMLElement>('[data-liens-rapides-mobile]')
  if (barre) {
    let precedent = window.scrollY
    let enAttente = false
    const mettreAJour = () => {
      enAttente = false
      const y = window.scrollY
      const ecart = y - precedent
      const enBas = window.innerHeight + y >= document.documentElement.scrollHeight - 2
      if (y <= 0 || enBas) barre.removeAttribute('data-masquee')
      else if (Math.abs(ecart) < SEUIL) return
      else barre.toggleAttribute('data-masquee', ecart > 0)
      precedent = y
    }
    window.addEventListener(
      'scroll',
      () => {
        if (enAttente) return
        enAttente = true
        requestAnimationFrame(mettreAJour)
      },
      { passive: true },
    )

    // La page réserve en bas la hauteur réelle de la barre : avec le texte
    // agrandi, elle passe sur deux lignes et dépasse les 86 px par défaut
    new ResizeObserver(() => {
      if (barre.offsetHeight) document.documentElement.style.setProperty('--hauteur-liens-rapides', `${Math.ceil(barre.offsetHeight)}px`)
    }).observe(barre)
  }
</script>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a,
  button {
    color: var(--couleur-surface);
  }

  a:hover {
    color: var(--couleur-surface);
  }

  /* Le bleu du focus global disparaît sur le fond bleu */
  :focus-visible {
    outline-color: var(--couleur-surface);
    outline-offset: -3px;
  }

  button {
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* ---- Bureau ---- */
  .liens-rapides-bureau {
    display: none;
  }

  @media (min-width: 900px) {
    .liens-rapides-bureau {
      display: flex;
      position: fixed;
      z-index: var(--z-tiroir);
      top: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      justify-content: center;
      pointer-events: none;
    }
  }

  /* Repliée : seule la languette (--languette, les icônes) dépasse */
  .panneau {
    --languette: 40px;
    padding-block: 8px;
    border-radius: var(--rayon-petit) 0 0 var(--rayon-petit);
    background-color: var(--bleu-principal);
    box-shadow: var(--ombre-2);
    pointer-events: auto;
    transform: translateX(calc(100% - var(--languette)));
    transition: transform var(--duree-courte-4) var(--courbe-emphase-acceleree);
  }

  .panneau:focus-within {
    transform: none;
    transition: transform var(--duree-moyenne-4) var(--courbe-emphase-deceleree);
  }

  @media (min-width: 1200px) {
    .panneau:hover {
      transform: none;
      transition: transform var(--duree-moyenne-4) var(--courbe-emphase-deceleree);
    }
  }

  /* Icône centrée dans la languette : 4 px de marge + 4 px de rembourrage
     de chaque côté d'une icône de 24 px */
  .panneau a,
  .panneau button {
    display: flex;
    align-items: center;
    width: calc(100% - 8px);
    min-height: 48px;
    margin: 0 4px;
    padding: 8px 16px 8px 4px;
    border-radius: 6px;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duree-courte-4) var(--courbe-standard);
  }

  .panneau a:hover,
  .panneau button:hover {
    background-color: color-mix(in srgb, var(--couleur-surface) 10%, transparent);
  }

  .icone {
    display: inline-flex;
    flex-shrink: 0;
  }

  .libelle {
    margin-left: 16px;
    font-size: 1rem;
    font-weight: var(--graisse-normale);
    line-height: 1.6;
  }

  /* ---- Mobile ---- */
  .liens-rapides-mobile {
    display: flex;
    position: fixed;
    z-index: var(--z-tiroir);
    right: 0;
    bottom: 0;
    left: 0;
    justify-content: center;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
    background-color: var(--bleu-principal);
    box-shadow: var(--ombre-2);
    transition: translate var(--duree-moyenne-1) var(--courbe-emphase-deceleree);
  }

  /* Retrait plus bref que l'apparition, même chemin ; l'ombre sort aussi */
  .liens-rapides-mobile[data-masquee]:not(:focus-within) {
    translate: 0 calc(100% + 1rem);
    transition: translate var(--duree-courte-4) var(--courbe-standard);
  }

  /* Avec le texte agrandi, les boutons passent sur une deuxième ligne au
     lieu de sortir de l'écran (WCAG 1.4.10) */
  .liens-rapides-mobile ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    width: 500px;
    max-width: 100%;
  }

  /* Icône et petit libellé dessous (le nom accessible reste le libellé
     complet, qui contient le mot affiché : WCAG 2.5.3) */
  .liens-rapides-mobile a,
  .liens-rapides-mobile button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 4rem;
    min-height: 3.5rem;
    padding: 0.375rem 0.25rem;
    border-radius: var(--rayon-tres-petit);
    color: var(--couleur-surface);
    text-decoration: none;
  }

  .etiquette {
    font-size: 0.75rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.2;
    white-space: nowrap;
  }

  .liens-rapides-mobile :global(svg) {
    display: block;
  }

  @media (width < 900px) {
    /* --hauteur-liens-rapides : posée par le script (hauteur réelle, zone
       des gestes comprise) ; 86 px sans script */
    :global(body) {
      padding-bottom: var(--hauteur-liens-rapides, calc(86px + env(safe-area-inset-bottom, 0px)));
    }

    :global(html) {
      scroll-padding-bottom: var(--hauteur-liens-rapides, calc(86px + env(safe-area-inset-bottom, 0px)));
    }
  }

  @media (min-width: 900px) {
    .liens-rapides-mobile {
      display: none;
    }
  }

  .libchat {
    position: fixed;
    z-index: 99999;
    right: 20px;
    bottom: 80px;
  }

  @media (forced-colors: active) {
    .panneau,
    .liens-rapides-mobile {
      border: 1px solid CanvasText;
    }
  }
</style>
