---
/*
 * En-tête du site (TopAppBar et TopAppBarSm de coquille-web).
 *
 * Les deux barres sont rendues en HTML et basculées en CSS à 1200 px :
 * plus de saut à l'hydratation comme avec useMediaQuery.
 *
 * - Bureau : voile bleu foncé uni en haut de page, blanche et
 *   ombrée après 50 px de défilement (useScrollTrigger de la source).
 * - Compacte : fond clair, logo UdeM et « Les bibliothèques » en dessous.
 *
 * Le bouton Menu suit le motif « disclosure navigation » de l'APG
 * (aria-expanded, aria-controls ; Échap ferme et rend le focus au bouton).
 * Les deux boutons Menu commandent le même rideau (PanneauMenu), placé après
 * les deux barres : il suit le bouton visible dans l'ordre de tabulation.
 * Corrigé : TopAppBarSm imbriquait deux boutons ; il n'en reste qu'un.
 *
 * La loupe ouvre le même rideau en mode « recherche » : seule la recherche
 * du haut du menu (Sofia ou les sites, Mon dossier, Obtenir un document),
 * le focus dans le champ, et dessous « Afficher le menu », qui déplie le
 * reste (événement « menu:deplier » de PanneauMenu). Le mode est posé sur
 * le rideau (data-mode) ; la loupe devient un X tant qu'il est ouvert en
 * mode recherche, le bouton Menu une fois le menu entier affiché.
 */
import { sansBase } from '@/lib/chemin'
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowRight'
import { MagnifyingGlassIcon } from '@phosphor-icons/react/dist/ssr/MagnifyingGlass'
import { XIcon } from '@phosphor-icons/react/dist/ssr/X'
import PanneauMenu from './entete/PanneauMenu.astro'
import BurgerIcon from '@/components/icones/BurgerIcon.astro'
import { PAGES_PRINCIPALES, estCourante } from '@/data/navigation'
import logoUdem from '@/components/icones/logo-udem.svg'
import logoUdemNoir from '@/components/icones/logo-udem-noir.svg'

const chemin = sansBase(Astro.url.pathname)
---

<header class="entete" data-entete>
  <span class="voile" aria-hidden="true" data-voile-menu></span>

  <div class="barre-bureau">
    <div class="rangee">
      <div class="marque">
        <a class="logo-udem" href="https://www.umontreal.ca">
          <img src={logoUdem.src} alt="Université de Montréal" width="135" height="59" />
        </a>
        <span class="separateur" aria-hidden="true"></span>
        <a class="nom-site" href="/">Les bibliothèques</a>
      </div>

      <nav class="navigation-principale" aria-label="Navigation principale">
        <ul>
          {
            PAGES_PRINCIPALES.map(({ url, libelle }) => (
              <li>
                <a href={url} aria-current={estCourante(chemin, url) ? 'page' : undefined}>
                  {libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="je-donne" href="/nous-soutenir/">
        Je donne
        <span class="icone-je-donne"><ArrowRightIcon size={36} aria-hidden="true" /></span>
      </a>

      <div class="outils">
        <button type="button" class="bouton-icone bouton-recherche" aria-label="Rechercher" aria-expanded="false" aria-controls="menu-principal" data-bouton-recherche>
          <span class="si-ferme"><MagnifyingGlassIcon size={24} weight="bold" aria-hidden="true" /></span>
          <span class="si-ouvert"><XIcon size={26} weight="bold" aria-hidden="true" /></span>
        </button>
        <button type="button" class="bouton-icone bouton-menu" aria-label="Menu" aria-expanded="false" aria-controls="menu-principal" data-bouton-menu>
          <span class="libelle-menu" aria-hidden="true"><span class="si-ferme">Menu</span><span class="si-ouvert">Fermer</span></span>
          <span class="si-ferme">
            <BurgerIcon size={34} color="currentColor" />
          </span>
          <span class="si-ouvert"><XIcon size={34} weight="bold" aria-hidden="true" /></span>
        </button>
      </div>
    </div>
  </div>

  <div class="barre-compacte">
    <div class="rangee">
      <a class="marque-compacte" href="/">
        <img src={logoUdemNoir.src} alt="Université de Montréal" width="140" height="61" />
        <span>Les bibliothèques<span class="visuellement-masque"> – Accueil</span></span>
      </a>
      <div class="outils">
        <button type="button" class="bouton-icone bouton-recherche recherche-compacte" aria-label="Rechercher" aria-expanded="false" aria-controls="menu-principal" data-bouton-recherche>
          <span class="si-ferme"><MagnifyingGlassIcon size={24} weight="bold" aria-hidden="true" /></span>
          <span class="si-ouvert"><XIcon size={26} weight="bold" aria-hidden="true" /></span>
        </button>
        <button type="button" class="bouton-icone bouton-menu" aria-label="Menu" aria-expanded="false" aria-controls="menu-principal" data-bouton-menu>
          <span class="si-ferme">
            <BurgerIcon size={34} color="currentColor" />
          </span>
          <span class="si-ouvert"><XIcon size={34} weight="bold" aria-hidden="true" /></span>
        </button>
      </div>
    </div>
  </div>

  <PanneauMenu id="menu-principal" />
</header>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]')

  if (entete) {
    // Apparence de la barre de bureau après 50 px de défilement
    // (et menu ouvert : la barre blanche se raccorde à la feuille du menu).
    // Sans bannière photo sous l'en-tête (nouvelles, répertoire…), la barre
    // est blanche d'office : le texte blanc sur le voile ne faisait que
    // 3,43:1 sur le fond clair de la page (WCAG 1.4.3).
    const sansBanniere = !document.querySelector('.super-hero, .super-hero-2, .banniere')
    const majDefilement = () =>
      entete.toggleAttribute('data-defile', sansBanniere || window.scrollY > 50 || entete.hasAttribute('data-menu-ouvert'))
    majDefilement()
    window.addEventListener('scroll', majDefilement, { passive: true })

    // --hauteur-entete (marge de défilement des ancres et du focus, WCAG
    // 2.4.11) suit la hauteur réelle : avec le texte agrandi ou espacé, la
    // barre passe sur deux rangées et dépasse la valeur des jetons
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--hauteur-entete', `${Math.ceil(entete.getBoundingClientRect().height)}px`)
    }).observe(entete)

    const boutons = [...entete.querySelectorAll<HTMLButtonElement>('[data-bouton-menu]')]
    const loupes = [...entete.querySelectorAll<HTMLButtonElement>('[data-bouton-recherche]')]
    const panneau = document.getElementById('menu-principal')
    type Mode = 'recherche' | 'complet'
    // Bouton qui a ouvert le rideau (il reprend le focus à la fermeture)
    let ouvert: HTMLButtonElement | null = null
    let mode: Mode = 'complet'

    // État des boutons : la loupe est « ouverte » en mode recherche, le
    // bouton Menu en mode complet ; chacun montre alors un X
    function majBoutons() {
      for (const b of boutons) {
        const actif = !!ouvert && mode === 'complet'
        b.setAttribute('aria-expanded', String(actif))
        // Le nom suit le libellé visible « Fermer » de la barre de bureau (WCAG 2.5.3)
        b.setAttribute('aria-label', actif ? 'Fermer le menu' : 'Menu')
      }
      for (const l of loupes) {
        const actif = !!ouvert && mode === 'recherche'
        l.setAttribute('aria-expanded', String(actif))
        l.setAttribute('aria-label', actif ? 'Fermer la recherche' : 'Rechercher')
      }
    }

    function fermer({ rendreFocus = false } = {}) {
      if (!ouvert) return
      const bouton = ouvert
      panneau?.setAttribute('hidden', '')
      entete!.removeAttribute('data-menu-ouvert')
      ouvert = null
      majBoutons()
      majDefilement()
      if (rendreFocus) bouton.focus()
    }

    function changerMode(nouveau: Mode) {
      mode = nouveau
      if (panneau) panneau.dataset.mode = nouveau
      // La poignée du bas (mobile) ferme ce qui est ouvert
      panneau?.querySelector('[data-poignee-menu]')?.setAttribute('aria-label', nouveau === 'recherche' ? 'Fermer la recherche' : 'Fermer le menu')
      majBoutons()
    }

    function ouvrir(bouton: HTMLButtonElement, nouveau: Mode) {
      fermer()
      // Le rideau remplit la fenêtre sous l'en-tête, où qu'il soit (bandeau
      // d'urgence au-dessus, page défilée ou non)
      panneau?.style.setProperty('--haut-menu', `${Math.max(0, entete!.getBoundingClientRect().bottom)}px`)
      ouvert = bouton
      changerMode(nouveau)
      panneau?.removeAttribute('hidden')
      entete!.setAttribute('data-menu-ouvert', '')
      majDefilement()
      if (nouveau === 'recherche') panneau?.querySelector<HTMLInputElement>('input[type=search]')?.focus({ preventScroll: true })
    }

    // Passage d'un mode à l'autre, animé. Repli (loupe, menu entier
    // ouvert) : le reste du menu s'efface en remontant, puis la feuille se
    // rétracte jusqu'à la recherche. Dépliage (Menu ou « Afficher le
    // menu ») : la feuille s'allonge et le reste du menu apparaît en
    // descendant, en léger décalage. La poignée, collée au bas de la
    // feuille, suit. Sans animation si le mouvement réduit est demandé.
    const COURBE_ENTREE = 'cubic-bezier(0.05, 0.7, 0.1, 1)'
    const COURBE_SORTIE = 'cubic-bezier(0.3, 0, 1, 1)'
    let animation = false
    const reduit = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const feuille = () => panneau?.querySelector<HTMLElement>('.feuille')
    const autresGroupes = () => [...(feuille()?.querySelectorAll<HTMLElement>('.grille > :not(.sofia, .deplier)') ?? [])].filter((e) => e.offsetParent)

    // Hauteur de la feuille animée de sa valeur actuelle à celle du mode
    // suivant
    async function changerHauteur(f: HTMLElement, avant: number) {
      f.style.height = ''
      const apres = f.getBoundingClientRect().height
      // Pas de barre de défilement le temps de l'agrandissement
      f.style.overflowY = 'hidden'
      await f.animate([{ height: `${avant}px` }, { height: `${apres}px` }], { duration: 300, easing: COURBE_ENTREE }).finished.catch(() => {})
      f.style.overflowY = ''
    }

    async function replier() {
      const f = feuille()
      const champ = panneau?.querySelector<HTMLInputElement>('input[type=search]')
      if (!f || reduit() || animation) {
        changerMode('recherche')
        f?.scrollTo({ top: 0 })
        champ?.focus({ preventScroll: true })
        return
      }
      animation = true
      const autres = autresGroupes()
      const avant = f.getBoundingClientRect().height
      f.style.height = `${avant}px`
      f.scrollTo({ top: 0, behavior: 'smooth' })
      await Promise.all(
        autres.map((e) => e.animate([{ opacity: 1, translate: '0 0' }, { opacity: 0, translate: '0 -1rem' }], { duration: 150, easing: COURBE_SORTIE, fill: 'forwards' }).finished),
      )
      changerMode('recherche')
      for (const e of autres) e.getAnimations().forEach((a) => a.cancel())
      champ?.focus({ preventScroll: true })
      await changerHauteur(f, avant)
      animation = false
    }

    async function deplier(bouton: HTMLButtonElement) {
      ouvert = bouton
      const f = feuille()
      if (!f || reduit() || animation) {
        changerMode('complet')
        return
      }
      animation = true
      const avant = f.getBoundingClientRect().height
      f.style.height = `${avant}px`
      changerMode('complet')
      const autres = autresGroupes()
      autres.forEach((e, i) =>
        e.animate([{ opacity: 0, translate: '0 -1rem' }, { opacity: 1, translate: '0 0' }], { duration: 300, delay: 60 + i * 50, easing: COURBE_ENTREE, fill: 'backwards' }),
      )
      await changerHauteur(f, avant)
      animation = false
    }

    for (const bouton of boutons) {
      bouton.addEventListener('click', () => {
        if (ouvert && mode === 'complet') fermer()
        // Ouvert en mode recherche : le menu se déplie sans se refermer
        else if (ouvert) deplier(bouton)
        else ouvrir(bouton, 'complet')
      })
    }
    for (const loupe of loupes) {
      loupe.addEventListener('click', () => {
        if (ouvert && mode === 'recherche') fermer()
        // Menu entier ouvert : il se replie sur la recherche seule, et la
        // loupe prend le X
        else if (ouvert) {
          ouvert = loupe
          replier()
        } else ouvrir(loupe, 'recherche')
      })
    }
    // « Afficher le menu », sous la recherche (PanneauMenu)
    document.addEventListener('menu:deplier', () => {
      if (!ouvert) return
      deplier(boutons.find((b) => b.offsetParent) ?? ouvert)
    })
    entete.querySelector('[data-voile-menu]')?.addEventListener('click', () => fermer())

    // Poignée du rideau (tapotement ou glissé vers le haut, PanneauMenu)
    document.addEventListener('menu:fermer', () => fermer({ rendreFocus: true }))

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !ouvert) return
      // Une boîte de dialogue ouverte par-dessus (recherche) gère sa propre Échap
      if (document.querySelector('dialog[open]')) return
      fermer({ rendreFocus: true })
    })

    // Le panneau se referme quand le focus quitte le menu (tabulation après
    // le dernier lien) : sinon il resterait ouvert par-dessus la page.
    entete.addEventListener('focusout', (e) => {
      if (!ouvert) return
      const suivant = e.relatedTarget as Node | null
      if (!suivant) return
      // Les boutons Menu et loupe restent dans le parcours (on passe de l'un à l'autre)
      if ([...boutons, ...loupes].some((b) => b.contains(suivant)) || panneau?.contains(suivant)) return
      fermer()
    })

  }
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: var(--z-entete);
  }

  /* Menu ouvert : l'en-tête et son panneau passent au-dessus des liens
     rapides, comme le tiroir modal de la source */
  .entete[data-menu-ouvert] {
    z-index: calc(var(--z-tiroir) + 1);
  }

  /* Le voile suit le panneau du menu : fondu à l'ouverture et à la
     fermeture (display en allow-discrete le garde le temps du fondu) */
  .voile {
    display: none;
    position: fixed;
    z-index: 1;
    inset: 0;
    background-color: color-mix(in srgb, var(--bleu-fonce) 50%, transparent);
    opacity: 0;
    transition:
      opacity var(--duree-courte-4) var(--courbe-standard),
      display var(--duree-courte-4) allow-discrete;
  }

  .entete[data-menu-ouvert] .voile {
    display: block;
    opacity: 1;
    transition-duration: var(--duree-moyenne-1);
  }

  @starting-style {
    .entete[data-menu-ouvert] .voile {
      opacity: 0;
    }
  }

  /* Les barres (fond compris) passent au-dessus du voile et du rideau, qui
     sort de derrière elles */
  .barre-bureau,
  .barre-compacte {
    position: relative;
    z-index: 3;
  }

  .outils {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bouton-icone {
    display: inline-flex;
    position: relative;
    align-items: center;
    justify-content: center;
    /* 44 px : commande principale sur mobile (40 px auparavant) */
    width: var(--taille-cible);
    height: var(--taille-cible);
    padding: 8px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .bouton-icone :global(svg) {
    display: block;
    flex-shrink: 0;
  }

  .bouton-menu {
    width: 50px;
    height: 50px;
  }

  .bouton-menu .si-ouvert,
  .bouton-menu[aria-expanded='true'] .si-ferme,
  .bouton-recherche .si-ouvert,
  .bouton-recherche[aria-expanded='true'] .si-ferme {
    display: none;
  }

  .bouton-menu[aria-expanded='true'] .si-ouvert,
  .bouton-recherche[aria-expanded='true'] .si-ouvert {
    display: inline;
  }

  /* ---- Barre compacte (< 1200 px) ---- */
  .barre-bureau {
    display: none;
  }

  .barre-compacte {
    border-bottom: 1px solid color-mix(in srgb, var(--couleur-texte) 12%, transparent);
    background-color: var(--couleur-fond);
    color: var(--couleur-texte);
  }

  .barre-compacte .rangee {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1500px;
    min-height: 56px;
    margin-inline: auto;
    padding: 8px 16px;
  }

  .marque-compacte {
    display: flex;
    flex-direction: column;
    color: var(--couleur-texte);
    font-size: 16px;
    font-weight: var(--graisse-forte);
    line-height: 1.5;
    text-decoration: none;
  }

  .marque-compacte:hover {
    color: var(--couleur-texte);
    text-decoration: underline;
  }

  .marque-compacte img {
    width: 120px;
    height: auto;
  }

  /* Le bouton unique garde l'emprise des deux boutons imbriqués de la source
     (66 px) : l'icône reste à sa place et la cible est plus grande. */
  .barre-compacte .bouton-menu {
    width: 66px;
    height: 66px;
    padding: 16px;
  }

  /* Le rideau couvre la fenêtre sous 1200 px : la page ne défile plus
     derrière lui */
  @media (width < 1200px) {
    :global(html:has(.entete[data-menu-ouvert])) {
      overflow: hidden;
    }
  }

  @media (min-width: 600px) {
    .barre-compacte .rangee {
      min-height: 64px;
      padding-inline: 24px;
    }
  }

  @media (min-width: 900px) {
    .marque-compacte img {
      width: 140px;
    }
  }

  /* ---- Barre de bureau (≥ 1200 px) ---- */
  @media (min-width: 1200px) {
    .barre-compacte {
      display: none;
    }

    /* Teinte gris-bleu de la bande de la recherche Sofia de l'accueil
       (RechercheSofiaAccueil), en aplat sur toute la barre, assombrie pour
       le contraste (WCAG 1.4.3) : texte blanc à 7,13:1 même sur une photo
       entièrement blanche (le mélange précédent, gris 700 à 45 % et 62 %
       d'opacité, tombait à 1,98:1). */
    .barre-bureau {
      display: block;
      /* Couleurs de la palette, pas des rôles : posée sur la photo de la
         bannière, la barre est la même dans les deux thèmes */
      background-color: color-mix(in srgb, color-mix(in srgb, var(--gris-700) 90%, var(--bleu-200)) 85%, transparent);
      color: var(--blanc-casse);
      transition:
        background-color var(--duree-moyenne-4) var(--courbe-emphase-deceleree),
        box-shadow var(--duree-moyenne-4) var(--courbe-emphase-deceleree),
        color var(--duree-courte-4) var(--courbe-emphase-deceleree);
    }

    .entete[data-defile] .barre-bureau {
      background-color: var(--couleur-surface);
      box-shadow: var(--ombre-1);
      color: var(--couleur-neutre-700);
    }
  }

  /* Hauteur minimale plutôt que fixe, et passage à la ligne autorisé : avec
     le texte agrandi à 200 % (WCAG 1.4.4), le menu et « Je donne » ne
     tiennent plus sur une rangée de 5rem et débordaient de la page. */
  .barre-bureau .rangee {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: var(--largeur-max);
    min-height: 5rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .marque {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-right: auto;
    user-select: none;
  }

  .logo-udem {
    display: flex;
    align-items: center;
  }

  .logo-udem img {
    width: auto;
    height: 59px;
    filter: brightness(0) invert(1);
    transition:
      filter var(--duree-moyenne-2) var(--courbe-standard),
      opacity var(--duree-moyenne-2) var(--courbe-standard);
  }

  .entete[data-defile] .logo-udem img {
    filter: none;
  }

  /* Thème sombre : le logo noir passe en blanc sur la barre foncée */
  :global(:root[data-theme='sombre']) .marque-compacte img,
  :global(:root[data-theme='sombre']) .entete[data-defile] .logo-udem img {
    filter: brightness(0) invert(1);
  }

  .logo-udem:hover img {
    opacity: 0.8;
  }

  .separateur {
    height: 32px;
    border-left: 1px solid currentColor;
  }

  .nom-site {
    color: inherit;
    font-size: 1.1875rem;
    font-weight: var(--graisse-normale);
    line-height: 1.5;
    letter-spacing: 0.01188rem;
    text-decoration: none;
  }

  .nom-site:hover {
    color: inherit;
    text-decoration: underline;
  }

  /* La navigation prend la place libre et se replie sur elle-même, alignée
     à droite : avec l'espacement du texte agrandi (WCAG 1.4.12), c'est elle
     qui passe sur deux lignes, et non toute la rangée (la loupe et le bouton
     Menu tombaient sous le logo, que le libellé « Menu » chevauchait). */
  .navigation-principale {
    flex: 1 1 0;
    min-width: 0;
  }

  .navigation-principale ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-principale a {
    display: inline-flex;
    position: relative;
    align-items: center;
    min-height: 56px;
    padding-inline: 22px;
    color: inherit;
    font-size: 1rem;
    font-weight: var(--graisse-normale);
    line-height: 1.2;
    text-decoration: none;
  }

  /* Entre 1200 et 1439 px d'écran, la rangée complète (marque, menu, « Je donne »,
     outils) demande environ 1035 px plus les marges des liens. Au lieu d'une
     marge fixe de 10 px, la marge suit la place réellement libre dans la
     rangée (unités cqi : la largeur de la rangée, barre de défilement
     déduite) : toute la place restante, moins 7 px de sécurité, va aux 10
     marges des 5 liens. Elle passe de 10 px à 1200 px à la marge normale de
     22 px vers 1340 px. « Je donne » est allégé (flèche de 24 px). On ne
     recule pas le seuil de la barre compacte : SuperHero et la bannière de
     section se glissent sous l'en-tête transparent dès 1200 px. */
  .barre-bureau .rangee {
    container-type: inline-size;
  }

  /* 1395 px : largeur de la rangée à 1440 px d'écran (mesurée). La règle
     suit la rangée et non l'écran : pas de seuil de plus dans la page. */
  @container (width < 1395px) {
    .navigation-principale ul {
      gap: 0;
    }

    .navigation-principale a {
      padding-inline: clamp(8px, (100cqi - 1042px) / 10, 22px);
    }

    /* Sélecteurs plus précis : les règles de base de .je-donne viennent plus
