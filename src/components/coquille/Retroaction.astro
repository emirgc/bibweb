---
/*
 * Rétroaction de l'usager (RetroactionUsager.jsx) : le web component
 * <bib-retroaction-usager> (« Cette page vous a été utile? »), en bas du
 * contenu. La source l'encadrait comme une alerte d'information ; ici, il
 * reste discret : une ligne centrée, sur le fond de la page.
 *
 * La source posait role="alert" sur ce cadre statique : les lecteurs d'écran
 * l'annonçaient au chargement de chaque page. Ici, un simple repère
 * complémentaire nommé ; le web component gère lui-même ses annonces
 * (formulaire aria-live).
 */
interface Props {
  class?: string
  style?: string
  lang?: string
}

const { class: classe, style, lang } = Astro.props
---

<script is:inline type="module" src="https://cdn.jsdelivr.net/gh/bibudem/ui@1/dist/bib-retroaction-usager.js"></script>
<aside class:list={['retroaction', classe]} style={style} lang={lang} aria-label="Rétroaction sur la page">
  <bib-retroaction-usager data-retroaction></bib-retroaction-usager>
</aside>

<script>
  // Le web component pose la question au-dessus des boutons, alignés à
  // gauche, dans sa racine fantôme (ouverte). Une feuille ajoutée met la
  // question et les pouces sur une ligne centrée ; la suite (commentaire,
  // remerciement) passe dessous, centrée elle aussi.
  const AJOUT = `
    :host { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.25rem 0.75rem; text-align: center; }
    .survey-title { margin: 0; }
    form { display: flex; flex-direction: column; align-items: center; }
    .radio-group { justify-content: center; margin: 0; }
  `
  customElements.whenDefined('bib-retroaction-usager').then(() => {
    for (const element of document.querySelectorAll<HTMLElement>('[data-retroaction]')) {
      const racine = element.shadowRoot
      if (!racine) continue
      const feuille = new CSSStyleSheet()
      feuille.replaceSync(AJOUT)
      racine.adoptedStyleSheets = [...racine.adoptedStyleSheets, feuille]
    }
  })
</script>

<style>
  /* Discret : ni cadre ni icône, sur le fond de la page, centré sous le
     contenu, en texte secondaire */
  .retroaction {
    margin-block: var(--espace-5) var(--espace-2);
    padding-top: var(--espace-3);
    border-top: 1px solid var(--couleur-bordure);
    color: var(--couleur-texte-secondaire);
    font-size: 0.875rem;
    line-height: 1.43;
    /* Variables lues par le web component */
    --bib-comp-retroaction-usager-title-weight: var(--graisse-moyenne);
    --md-sys-typescale-label-large-size: 0.875em;
  }

  bib-retroaction-usager {
    display: block;
  }
</style>
