---
/*
 * Menu du site : un rideau qui descend sous l'en-tête, révélé par les deux
 * boutons Menu (barre compacte et barre de bureau) selon le motif
 * « disclosure navigation » de l'APG. Une seule <nav> pour les deux barres :
 * les boutons pointent tous deux vers elle.
 *
 * Contenu (les items de SideNavContent.jsx, réagencés par usage) :
 * 1. Recherche Sofia, l'action principale du site (tout en haut, partout),
 *    ou dans les sites des bibliothèques, avec suggestions (RechercheMenu),
 *    avec à côté la suite du parcours : Mon dossier, Obtenir un document ;
 * 2. Explorer : Accueil et les pages principales, en grand (sous 1200 px
 *    seulement ; la barre de bureau les montre déjà) ;
 * 3. Accès rapide : les tâches courantes (LIENS_MENU) en tuiles, puis « À
 *    propos des Bibliothèques », à part : une carte claire bordée, avec une
 *    ligne de description (l'institution, pas une tâche) ;
 * 4. Studio·bib, Boîte à outils, Ressources : repliables sous 1200 px
 *    (<details name>, un seul ouvert à la fois) ; au-delà, un catalogue
 *    avec aperçu (onglets de l'APG : les services en rangée en haut, près
 *    du bouton Menu, l'aperçu du service choisi dessous) ;
 * 5. Sous 1200 px, « Je donne » (absent de la barre compacte) termine le
 *    menu, dans le défilement, puis un pied collé au bas de la feuille ne
 *    porte que la poignée de fermeture.
 *
 * Mode « recherche » (data-mode, posé par Entete.astro quand la loupe
 * ouvre le rideau) : la feuille ne montre que le groupe 1, puis, centré
 * dessous, « Afficher le menu », puis la poignée (sous 1200 px). Le bouton
 * émet « menu:deplier », Entete.astro repasse en mode complet et le reste
 * du menu apparaît (même entrée en décalage que les groupes). Le focus va
 * alors au premier lien apparu. La loupe, menu entier ouvert, le replie.
 *
 * La poignée est un bouton « Fermer le menu » ; au doigt, on peut aussi la
 * glisser vers le haut : la feuille suit le doigt et se referme passé le
 * quart de sa hauteur ou sur un geste vif, sinon elle revient en place. Le
 * menu se ferme par l'événement « menu:fermer », écouté par Entete.astro.
 *
 * Bureau : l'accès rapide est la dernière colonne, à droite, sous le bouton
 * Menu (loi de Fitts : les tâches fréquentes au plus près du pointeur). Pour
 * que l'ordre du focus suive l'ordre visuel (WCAG 2.4.3) sans `order`, le
 * catalogue (bureau) est rendu avant l'accès rapide, et les cartes
 * repliables (mobile, tablette) après lui.
 *
 * Catalogue : flèches gauche et droite (haut et bas aussi), Début et Fin
 * entre les services (tabindex itinérant, activation au focus), Tab mène
 * ensuite aux liens de l'aperçu. À la souris, le survol d'un service
 * l'affiche après un court délai : un trajet en diagonale vers l'aperçu, qui
 * frôle un autre service, ne le change pas. Les onglets sont en haut plutôt
 * qu'à gauche : le pointeur, qui vient du bouton Menu en haut à droite, n'a
 * pas à traverser l'écran. Les rôles sont dans le HTML : le menu ne s'ouvre de
 * toute façon qu'avec JavaScript. Les deux rendus sont
 * basculés en CSS (display: none retire l'autre de l'arbre d'accessibilité).
 * Les titres de groupe ne sont pas des <h2> : placés avant le h1, ils casseraient la hiérarchie de la page ; ils
 * nomment leur liste par aria-labelledby.
 *
 * Couleurs : thème clair de la marque (surface, bleu foncé, bleu principal,
 * bleu 100), le liseré de chaque carte reprend sa couleur (navigation.ts).
 *
 * Mouvement : la feuille descend de derrière l'en-tête (translateY de -100 %
 * à 0, l'enveloppe rogne), puis les groupes apparaissent en léger décalage.
 * Fermeture plus brève, par le même chemin, sans décalage.
 */
import { sansBase } from '@/lib/chemin'
import { Image } from 'astro:assets'
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowRight'
import { ArrowUpRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowUpRight'
import { CaretDownIcon } from '@phosphor-icons/react/dist/ssr/CaretDown'
import { CARTES, LIENS_MENU, LIENS_SOFIA, PAGES_PRINCIPALES, estCourante, estExterne } from '@/data/navigation'
import RechercheMenu from './RechercheMenu.astro'

interface Props {
  id: string
}

const { id } = Astro.props
const chemin = sansBase(Astro.url.pathname)
const cibleExterne = (href: string) => (estExterne(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})
const PAGES = [{ url: '/', libelle: 'Accueil' }, ...PAGES_PRINCIPALES]
const courante = (url: string) => (url === '/' ? chemin === '/' : estCourante(chemin, url))
---

<nav class="rideau" id={id} aria-label="Menu" hidden data-panneau-menu>
  <div class="feuille">
    <div class="grille">
      <div class="groupe sofia" style="--i: 0">
        <RechercheMenu id={`${id}-sofia`} />
        <ul class="sofia-liens" aria-label="Sofia : suite du parcours">
          {
            LIENS_SOFIA.map(({ libelle, href, Icone }) => (
              <li>
                <a href={href} {...cibleExterne(href)}>
                  <Icone size={20} aria-hidden="true" className="icone" />
                  {libelle}
                  {estExterne(href) && <span class="visuellement-masque"> (nouvel onglet)</span>}
                  {estExterne(href) ? <ArrowUpRightIcon size={14} aria-hidden="true" /> : <ArrowRightIcon size={14} aria-hidden="true" />}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Mode recherche seulement (voir plus haut) */}
      <div class="deplier">
        <button type="button" class="deplier-bouton" data-deplier-menu>
          Afficher le menu
          <CaretDownIcon size={22} weight="bold" aria-hidden="true" className="deplier-fleche" />
        </button>
      </div>

      <div class="groupe explorer" style="--i: 1">
        <p class="surtitre" id={`${id}-explorer`}>Explorer</p>
        <ul class="pages" aria-labelledby={`${id}-explorer`}>
          {
            PAGES.map(({ url, libelle }) => (
              <li>
                <a href={url} aria-current={courante(url) ? 'page' : undefined}>
                  <span>{libelle}</span>
                  <ArrowRightIcon size={22} aria-hidden="true" className="fleche" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="groupe catalogue" style="--i: 1" data-catalogue>
        <div class="services" role="tablist" aria-label="Services" aria-orientation="horizontal">
          {
            CARTES.map((carte, i) => (
              <button
                type="button"
                class="service"
                role="tab"
                id={`${id}-onglet-${carte.cle}`}
                aria-controls={`${id}-apercu-${carte.cle}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                style={`--couleur-carte: ${carte.couleur}`}
                data-service
              >
                <Image src={carte.image} alt="" width={48} height={48} class="vignette" />
                <span class="service-titre">{carte.titre}</span>
                <CaretDownIcon size={18} weight="bold" aria-hidden="true" className="service-chevron" />
              </button>
            ))
          }
        </div>
        {
          CARTES.map((carte, i) => (
            <div class="apercu" role="tabpanel" id={`${id}-apercu-${carte.cle}`} aria-labelledby={`${id}-onglet-${carte.cle}`} hidden={i !== 0} style={`--couleur-carte: ${carte.couleur}`}>
              <div class="apercu-tete">
                <Image src={carte.image} alt="" width={72} height={72} class="vignette" />
                <div>
                  <p class="apercu-titre">{carte.titre}</p>
                  <p class="apercu-description">{carte.description}</p>
                </div>
              </div>
              {carte.appel && (
                <a class="apercu-appel" href={carte.appel.href}>
                  {carte.appel.libelle}
                  <ArrowRightIcon size={18} aria-hidden="true" />
                </a>
              )}
              <ul class="apercu-liens">
                {carte.liens.map((lien) => (
                  <li>
                    <a href={lien.href}>
                      {lien.libelle}
                      <ArrowRightIcon size={16} aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="groupe acces">
        <p class="surtitre" id={`${id}-acces`}>Accès rapide</p>
        <ul class="tuiles" aria-labelledby={`${id}-acces`}>
          {
            LIENS_MENU.map(({ libelle, href, Icone }) => (
              <li>
                <a href={href} {...cibleExterne(href)}>
                  <Icone size={24} aria-hidden="true" className="icone" />
                  <span class="tuile-libelle">
                    {libelle}
                    {estExterne(href) && <span class="visuellement-masque"> (nouvel onglet)</span>}
                  </span>
                  {estExterne(href) && <ArrowUpRightIcon size={14} aria-hidden="true" className="externe" />}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="a-propos" href="/a-propos/" aria-current={courante('/a-propos/') ? 'page' : undefined}>
          <span class="a-propos-texte">
            <span class="a-propos-titre">À propos des Bibliothèques</span>
            <span class="a-propos-description">Organisation, collections, rapports annuels</span>
          </span>
          <ArrowRightIcon size={18} aria-hidden="true" className="a-propos-fleche" />
        </a>
      </div>

      <ul class="groupe cartes-pliables" style="--i: 3" aria-label="Services et ressources">
        {
          CARTES.map((carte) => (
            <li style={`--couleur-carte: ${carte.couleur}`}>
              <details name={`${id}-cartes`}>
                <summary>
                  <Image src={carte.image} alt="" width={40} height={40} class="vignette" />
                  <span class="pliable-titre">{carte.titre}</span>
                  <CaretDownIcon size={20} aria-hidden="true" className="chevron" />
                </summary>
                <ul class="carte-liens">
                  {carte.liens.map((lien) => (
                    <li>
                      <a href={lien.href}>{lien.libelle}</a>
                    </li>
                  ))}
                </ul>
                {carte.appel && (
                  <a class="carte-appel" href={carte.appel.href}>
                    {carte.appel.libelle}
                    <ArrowRightIcon size={16} aria-hidden="true" />
                  </a>
                )}
              </details>
            </li>
          ))
        }
      </ul>

      <div class="donner">
        <a class="je-donne" href="/nous-soutenir/">
          Je donne
          <ArrowRightIcon size={22} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="pied">
      <button type="button" class="poignee" aria-label="Fermer le menu" data-poignee-menu>
        <span class="poignee-trait" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</nav>

<script>
  import { brancherRechercheSofia } from '@/lib/sofia'

  brancherRechercheSofia()

  // « Afficher le menu » (mode recherche) : Entete.astro déplie le menu ;
  // le focus passe au premier lien apparu, le bouton disparaissant
  for (const bouton of document.querySelectorAll<HTMLButtonElement>('[data-deplier-menu]')) {
    bouton.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('menu:deplier'))
      const grille = bouton.closest('.grille')
      requestAnimationFrame(() => {
        const premier = [...(grille?.querySelectorAll<HTMLElement>('a[href], button, summary') ?? [])].find((e) => !e.closest('.sofia, .deplier') && e.offsetParent)
        premier?.focus({ preventScroll: true })
      })
    })
  }

  // Poignée : un tapotement ferme ; un glissé vers le haut entraîne la feuille
  const SEUIL_DEPART = 8 // px avant de considérer le geste comme un glissé
  const VITESSE_FERMETURE = 0.5 // px/ms : un geste vif ferme même s'il est court

  for (const poignee of document.querySelectorAll<HTMLButtonElement>('[data-poignee-menu]')) {
    const feuille = poignee.closest<HTMLElement>('.feuille')
    if (!feuille) continue
    let depart: { y: number; t: number } | null = null
    let ecart = 0
    let glisse = false

    const fermer = () => document.dispatchEvent(new CustomEvent('menu:fermer'))

    poignee.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return
      depart = { y: e.clientY, t: e.timeStamp }
      ecart = 0
      glisse = false
      poignee.setPointerCapture(e.pointerId)
    })

    poignee.addEventListener('pointermove', (e) => {
      if (!depart) return
      ecart = Math.min(0, e.clientY - depart.y)
      if (!glisse && ecart > -SEUIL_DEPART) return
      glisse = true
      // La feuille suit le doigt, sans transition
      feuille.style.transition = 'none'
      feuille.style.transform = `translateY(${ecart}px)`
    })

    const relacher = (e: PointerEvent) => {
      if (!depart) return
      const vitesse = -ecart / Math.max(1, e.timeStamp - depart.t)
      depart = null
      if (!glisse) return
      // Rend la main aux transitions de la feuille : elle repart de la
      // position du doigt, vers le haut (fermeture) ou vers 0 (retour)
      feuille.style.transition = ''
      feuille.style.transform = ''
      if (-ecart > feuille.offsetHeight / 4 || vitesse > VITESSE_FERMETURE) fermer()
    }

    poignee.addEventListener('pointerup', relacher)
    poignee.addEventListener('pointercancel', relacher)

    poignee.addEventListener('click', () => {
      // Le clic qui suit un glissé est déjà traité par relacher
      if (glisse) {
        glisse = false
        return
      }
      fermer()
    })
  }

  // Catalogue de bureau : onglets verticaux (APG), et survol avec délai
  const DELAI_SURVOL = 120 // ms : le temps de traverser un service sans s'y arrêter

  for (const catalogue of document.querySelectorAll<HTMLElement>('[data-catalogue]')) {
    const services = [...catalogue.querySelectorAll<HTMLButtonElement>('[data-service]')]
    let minuterie: number | undefined

    const afficher = (index: number, focus = false) => {
      services.forEach((service, i) => {
        const actif = i === index
        service.setAttribute('aria-selected', String(actif))
        service.tabIndex = actif ? 0 : -1
        document.getElementById(service.getAttribute('aria-controls') ?? '')?.toggleAttribute('hidden', !actif)
      })
      if (focus) services[index].focus()
    }

    services.forEach((service, i) => {
      service.addEventListener('click', () => afficher(i))
      service.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || service.getAttribute('aria-selected') === 'true') return
        minuterie = window.setTimeout(() => {
          // Le focus clavier était dans l'aperçu qui se masque : il passe au
          // service affiché au lieu de retomber au début de la page
          const actif = document.activeElement
          afficher(i, !!actif && catalogue.contains(actif) && !services.includes(actif as HTMLButtonElement))
        }, DELAI_SURVOL)
      })
      service.addEventListener('pointerleave', () => window.clearTimeout(minuterie))
    })

    catalogue.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const evenement = e as KeyboardEvent
      const index = services.indexOf(document.activeElement as HTMLButtonElement)
      if (index < 0) return
      const dernier = services.length - 1
      const apres = index === dernier ? 0 : index + 1
      const avant = index === 0 ? dernier : index - 1
      const suivant = { ArrowRight: apres, ArrowDown: apres, ArrowLeft: avant, ArrowUp: avant, Home: 0, End: dernier }[evenement.key]
      if (suivant === undefined) return
      evenement.preventDefault()
      afficher(suivant, true)
    })
  }
</script>

<style>
  .rideau {
    /* Bas de l'en-tête dans la fenêtre, posé par Entete.astro à l'ouverture */
    --haut-menu: var(--hauteur-entete);

    position: absolute;
    z-index: 2;
    top: 100%;
    right: 0;
    left: 0;
    /* L'enveloppe rogne la feuille : elle sort de derrière l'en-tête */
    overflow: hidden;
    transition: display var(--duree-moyenne-1) allow-discrete;
  }

  .rideau[hidden] {
    display: none;
    pointer-events: none;
    transition-duration: var(--duree-courte-4);
  }

  .feuille {
    height: calc(100dvh - var(--haut-menu));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--couleur-bordure);
    background-color: var(--couleur-surface);
    color: var(--couleur-texte);
    box-shadow: var(--ombre-2);
    transition: transform var(--duree-moyenne-1) var(--courbe-emphase-deceleree);
  }

  @starting-style {
    .rideau:not([hidden]) .feuille {
      transform: translateY(-100%);
    }
  }

  .rideau[hidden] .feuille {
    transform: translateY(-100%);
    transition-duration: var(--duree-courte-4);
    transition-timing-function: var(--courbe-standard);
  }

  /* Les groupes suivent la feuille, en léger décalage (50 ms, 5 au plus) */
  .groupe {
    transition:
      opacity var(--duree-moyenne-1) var(--courbe-emphase-deceleree),
      translate var(--duree-moyenne-1) var(--courbe-emphase-deceleree);
    transition-delay: calc(min(var(--i), 5) * var(--duree-courte-1) + var(--duree-courte-2));
  }

  @starting-style {
    .rideau:not([hidden]) .groupe {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  .rideau[hidden] .groupe {
    opacity: 0;
    transition-delay: 0s;
    transition-duration: var(--duree-courte-3);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .rideau :global(svg) {
    flex-shrink: 0;
  }

  .grille {
    display: grid;
    gap: var(--espace-4);
    max-width: var(--largeur-max);
    margin-inline: auto;
    padding: var(--espace-3) 16px var(--espace-4);
  }

  .surtitre {
    margin: 0 0 var(--espace-1);
    color: var(--couleur-accent);
    font-size: 0.8125rem;
    font-weight: var(--graisse-forte);
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ---- Explorer ---- */
  .pages a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2);
    min-height: 3.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--couleur-bordure);
    font-size: 1.5rem;
    font-weight: var(--graisse-normale);
    line-height: 1.2;
    transition: color var(--duree-courte-4) var(--courbe-standard);
  }

  .pages a:hover {
    color: var(--couleur-lien);
  }

  .pages li:first-child a {
    color: var(--couleur-texte-secondaire);
  }

  .pages :global(.fleche) {
    color: var(--couleur-accent);
    transition: translate var(--duree-courte-4) var(--courbe-standard);
  }

  .pages a:focus-visible :global(.fleche) {
    translate: 4px 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .pages a:hover :global(.fleche) {
      translate: 4px 0;
    }
  }

  /* Page courante : graisse et pastille, pas la seule couleur */
  .pages li a[aria-current='page'] {
    color: var(--couleur-texte);
    font-weight: var(--graisse-forte);
  }

  .pages a[aria-current='page'] > span::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.625rem;
    border-radius: 50%;
    background-color: var(--rouge-orange);
    vertical-align: 0.2em;
  }

  /* ---- Suite du parcours Sofia : liens sous le champ (à côté dès 900 px) ---- */
  /* Élément de grille : sans min-width, la barre de recherche (liste
     déroulante comprise) l'élargirait au-delà de l'écran à 320 px */
  .sofia {
    min-width: 0;
  }

  .sofia-liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-2);
    margin: var(--espace-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .sofia-liens a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--couleur-texte);
    font-weight: var(--graisse-moyenne);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--couleur-accent) 45%, transparent);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--duree-courte-4) var(--courbe-standard);
  }

  .sofia-liens a:hover {
    color: var(--couleur-texte);
    text-decoration-color: currentColor;
  }

  .sofia-liens :global(svg) {
    flex-shrink: 0;
    color: var(--couleur-accent);
  }

  /* ---- Accès rapide ---- */
  /* Un seul écart entre les tuiles et jusqu'à « À propos », qui suit le
     même rythme que la grille */
  .acces {
    --i: 1;
    --ecart-tuiles: var(--espace-1);
  }

  .tuiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ecart-tuiles);
  }

  .tuiles a {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: var(--espace-1);
    height: 100%;
    min-height: 5.5rem;
    padding: 0.875rem;
    border-radius: var(--rayon-tres-petit);
    background-color: var(--bleu-principal);
    color: var(--couleur-sur-fonce);
    font-size: 0.9375rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.3;
    transition:
      background-color var(--duree-courte-4) var(--courbe-standard),
      scale var(--duree-courte-2) var(--courbe-standard);
  }

  /* Retour à l'appui, au doigt comme à la souris */
  .tuiles a:active {
    scale: 0.97;
  }

  /* Bleu UdeM, texte et icônes blancs (7,05:1) ; plus foncé au survol */
  .tuiles a:hover {
    background-color: var(--bleu-principal-fonce);
    color: var(--couleur-sur-fonce);
  }

  .tuiles :global(.externe) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
  }

  /* Sur deux colonnes, une dernière tuile seule prend toute la rangée */
  .tuiles li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .tuile-libelle {
    overflow-wrap: anywhere;
  }

  /* ---- À propos : carte claire bordée, à part des tuiles pleines ---- */
  .a-propos {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: 4rem;
    margin-top: var(--ecart-tuiles);
    padding: 0.75rem 1rem;
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-tres-petit);
    background-color: var(--couleur-teinte);
    color: var(--couleur-texte);
    text-decoration: none;
    transition:
      border-color var(--duree-courte-4) var(--courbe-standard),
      scale var(--duree-courte-2) var(--courbe-standard);
  }

  .a-propos:active {
    scale: 0.98;
  }

  .a-propos:hover {
    border-color: var(--couleur-accent);
    color: var(--couleur-texte);
  }

  .a-propos:hover .a-propos-titre {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .a-propos :global(.a-propos-fleche) {
    flex-shrink: 0;
    color: var(--couleur-accent);
  }

  .a-propos :global(.a-propos-fleche) {
    margin-inline-start: auto;
    transition: translate var(--duree-courte-4) var(--courbe-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .a-propos:hover :global(.a-propos-fleche) {
      translate: 0.25rem 0;
    }
  }

  .a-propos-texte {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .a-propos-titre {
    font-weight: var(--graisse-forte);
    line-height: 1.3;
  }

  /* Texte secondaire sur bleu 100 : 6,9:1 ; titre en bleu foncé : 15,7:1 */
  .a-propos-description {
    color: var(--couleur-texte-secondaire);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .a-propos[aria-current='page'] {
    border-color: var(--couleur-accent);
  }

  /* ---- Cartes repliables (< 900 px) ---- */
  .cartes-pliables {
    display: grid;
    gap: var(--espace-1);
  }

  .cartes-pliables details {
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-tres-petit);
    background-color: var(--couleur-fond);
    box-shadow: inset 4px 0 0 var(--couleur-carte);
  }

  .cartes-pliables summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.5rem 1rem;
    font-size: 1.0625rem;
    font-weight: var(--graisse-moyenne);
    cursor: pointer;
    list-style: none;
  }

  .cartes-pliables summary::-webkit-details-marker {
    display: none;
  }

  .pliable-titre {
    flex: 1 1 auto;
  }

  .cartes-pliables :global(.chevron) {
    color: var(--couleur-accent);
    transition: rotate var(--duree-courte-4) var(--courbe-standard);
  }

  .cartes-pliables details[open] :global(.chevron) {
    rotate: 180deg;
  }

  .cartes-pliables details > :not(summary) {
    margin-inline: 1rem;
  }

  /* Ouverture en hauteur, comme les accordéons du contenu (Accordion) */
  @supports (interpolate-size: allow-keywords) and selector(::details-content) {
    .cartes-pliables details {
      interpolate-size: allow-keywords;
    }

    .cartes-pliables details::details-content {
      block-size: 0;
      overflow-y: clip;
      opacity: 0;
      transition:
        block-size var(--duree-moyenne-1) var(--courbe-emphase),
        opacity var(--duree-moyenne-1) var(--courbe-emphase),
        content-visibility var(--duree-moyenne-1) allow-discrete;
    }

    .cartes-pliables details[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  .cartes-pliables details > :last-child {
    margin-bottom: 1rem;
  }

  .vignette {
    flex-shrink: 0;
    border-radius: 50%;
  }

  .carte-liens a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--couleur-texte);
    font-size: 1rem;
    line-height: 1.4;
    transition: color var(--duree-courte-4) var(--courbe-standard);
  }

  .carte-liens a:hover {
    color: var(--couleur-lien);
    text-decoration: underline;
  }

  .carte-appel {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    color: var(--couleur-lien);
    font-weight: var(--graisse-forte);
  }

  .carte-appel:hover {
    color: var(--couleur-lien-survol);
    text-decoration: underline;
  }

  /* ---- Catalogue avec aperçu (≥ 1200 px) ---- */
  .catalogue {
    display: none;
  }

  /* Services : onglets soulignés, sur un filet commun */
  .services {
    display: flex;
    gap: var(--espace-2);
    border-bottom: 1px solid var(--couleur-bordure);
  }

  .service {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    min-height: 3.5rem;
    padding: 0.5rem 0.25rem 0.75rem;
    border: 0;
    background: transparent;
    color: var(--couleur-texte);
    font: inherit;
    font-size: 1rem;
    font-weight: var(--graisse-moyenne);
    text-align: start;
    cursor: pointer;
    transition:
      color var(--duree-courte-4) var(--courbe-standard),
      box-shadow var(--duree-courte-4) var(--courbe-standard);
  }

  .service :global(.vignette) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .service:hover {
    box-shadow: inset 0 -3px 0 var(--couleur-bordure);
  }

  .service-titre {
    flex: 1 1 auto;
  }

  /* Flèche vers l'aperçu, dessous ; bleue sur le service choisi */
  .service :global(.service-chevron) {
    flex-shrink: 0;
    color: var(--couleur-texte-secondaire);
    transition: translate var(--duree-courte-4) var(--courbe-standard);
  }

  .service[aria-selected='true'] :global(.service-chevron) {
    color: var(--couleur-accent);
    translate: 0 2px;
  }

  /* Service affiché : trait de 3 px à sa couleur, graisse et flèche bleue
     (pas la seule couleur) */
  .service[aria-selected='true'] {
    box-shadow: inset 0 -3px 0 var(--couleur-carte);
    font-weight: var(--graisse-forte);
  }

  /* Aperçu : la présentation et le lien « Aller plus loin » sur une ligne,
     les liens du service dessous, sur toute la largeur */
  .apercu {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'tete appel'
      'liens liens';
    align-content: start;
    gap: var(--espace-3) var(--espace-4);
    padding: var(--espace-4);
    border: 1px solid var(--couleur-bordure);
    /* Coins du bas droits : le liseré de couleur reste un trait net, il ne
       remonte pas dans les arrondis */
    border-radius: var(--rayon-petit) var(--rayon-petit) 0 0;
    background-color: var(--couleur-surface);
    box-shadow: inset 0 -4px 0 var(--couleur-carte);
    grid-row: 2;
    grid-column: 1;
    /* Changement de service : fondu court du nouvel aperçu */
    transition:
      opacity var(--duree-courte-4) var(--courbe-standard-deceleree),
      translate var(--duree-courte-4) var(--courbe-standard-deceleree);
  }

  /* Hauteur fixe : les trois aperçus occupent la même case ; le panneau
     prend la hauteur du plus long et ne saute plus d'un service à l'autre.
     Masqué (attribut hidden) : invisible, hors de l'arbre d'accessibilité
     et du parcours au clavier (visibility), mais il garde sa place. */
  .apercu[hidden] {
    display: grid;
    visibility: hidden;
    opacity: 0;
    translate: 0 0.375rem;
    transition: none;
  }

  .apercu-tete {
    grid-area: tete;
    display: flex;
    align-items: center;
    gap: var(--espace-3);
  }

  .apercu-tete :global(.vignette) {
    width: 4rem;
    height: 4rem;
  }

  .apercu-titre {
    margin: 0;
    font-size: 1.5rem;
    font-weight: var(--graisse-forte);
    line-height: 1.2;
  }

  .apercu-description {
    margin: 0.25rem 0 0;
    color: var(--couleur-texte-secondaire);
    font-size: 1rem;
    line-height: 1.5;
  }

  .apercu-liens {
    grid-area: liens;
    align-self: start;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .apercu-liens a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-1);
    min-height: 3rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--couleur-bordure);
    font-size: 1rem;
    line-height: 1.3;
    transition: color var(--duree-courte-4) var(--courbe-standard);
  }

  .apercu-liens a:hover {
    color: var(--couleur-lien);
  }

  .apercu-liens :global(svg) {
    color: var(--couleur-accent);
    transition: translate var(--duree-courte-4) var(--courbe-standard);
  }

  .apercu-liens a:focus-visible :global(svg) {
    translate: 3px 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .apercu-liens a:hover :global(svg) {
      translate: 3px 0;
    }
  }

  .apercu-appel {
    grid-area: appel;
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: var(--espace-1);
    min-height: 3rem;
    padding-inline: 1.25rem;
    border-radius: var(--rayon-plein);
    background-color: var(--bleu-fonce);
    color: var(--couleur-sur-fonce);
    font-weight: var(--graisse-forte);
    transition: background-color var(--duree-courte-4) var(--courbe-standard);
  }

  .apercu-appel:hover {
    background-color: var(--bleu-fonce-survol);
    color: var(--couleur-sur-fonce);
  }

  .apercu-appel:focus-visible {
    outline-offset: 3px;
  }

  /* ---- Je donne : dernier élément du menu, pas collé ---- */
  .donner {
    display: grid;
    grid-column: 1 / -1;
  }

  .je-donne {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    padding-inline: 1.25rem;
    border-radius: var(--rayon-plein);
    background-color: var(--bleu-fonce);
    color: var(--couleur-sur-fonce);
    font-size: 1.0625rem;
    font-weight: var(--graisse-forte);
    transition: background-color var(--duree-courte-4) var(--courbe-standard);
  }

  .je-donne :global(svg) {
    color: var(--rouge-orange);
  }

  .je-donne:hover {
    background-color: var(--bleu-fonce-survol);
    color: var(--couleur-sur-fonce);
  }

  .je-donne:focus-visible {
    outline-offset: 3px;
  }

  /* ---- Mode recherche : la recherche seule, puis « Afficher le menu » ---- */
  .deplier {
    display: none;
  }

  /* La poignée du bas reste (sous 1200 px) : on ferme la recherche comme
     le menu, d'un tapotement ou d'un glissé vers le haut */
  .rideau[data-mode='recherche'] .grille > :not(.sofia, .deplier) {
    display: none;
  }

  /* La feuille prend la hauteur de la recherche ; le passage d'un mode à
     l'autre est animé par Entete.astro (hauteur, groupes) */
  .rideau[data-mode='recherche'] .feuille {
    height: auto;
  }

  /* Les suggestions, posées par-dessus le contenu, dépassent de la feuille
     courte : ni le rideau ni la feuille ne rognent en mode recherche (la
     liste flotte sur le voile, la page n'est pas blanchie). La feuille
     sort toujours de derrière l'en-tête, qui la couvre en glissant. */
  .rideau[data-mode='recherche'],
  .rideau[data-mode='recherche'] .feuille {
    overflow: visible;
  }

  .rideau[data-mode='recherche'] .deplier {
    display: flex;
    grid-column: 1 / -1;
    justify-content: center;
    margin-top: calc(-1 * var(--espace-2));
  }

  .deplier-bouton {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    min-height: var(--taille-cible);
    padding: 0.375rem 1.25rem;
    border: 0;
    border-radius: var(--rayon-plein);
    background: transparent;
    color: var(--couleur-accent);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: var(--graisse-forte);
    cursor: pointer;
    transition: background-color var(--duree-courte-4) var(--courbe-standard);
  }

  /* La flèche invite à descendre : elle avance d'un cran au survol */
  .deplier-bouton :global(.deplier-fleche) {
    transition: transform var(--duree-courte-4) var(--courbe-standard-deceleree);
  }

  @media (hover: hover) and (pointer: fine) {
    .deplier-bouton:hover {
      background-color: var(--couleur-teinte);
    }

    .deplier-bouton:hover :global(.deplier-fleche) {
      transform: translateY(3px);
    }
  }

  .deplier-bouton:focus-visible :global(.deplier-fleche) {
    transform: translateY(3px);
  }

  /* ---- Pied collé au bas de la feuille (< 1200 px) : la poignée ---- */
  .pied {
    position: sticky;
    bottom: 0;
    display: grid;
    gap: 0.25rem;
    padding: 0 16px;
    /* Hors de la barre des gestes et du bord arrondi des téléphones */
    padding-bottom: env(safe-area-inset-bottom, 0px);
    border-top: 1px solid var(--couleur-bordure);
    background-color: var(--couleur-surface);
  }

  .poignee {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: var(--taille-cible);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    /* Le glissé appartient à la poignée, pas au défilement de la feuille */
    touch-action: none;
  }

  .poignee-trait {
    width: 2.5rem;
    height: 0.3125rem;
    border-radius: var(--rayon-plein);
    background-color: var(--couleur-texte-secondaire);
    transition: scale var(--duree-courte-4) var(--courbe-standard);
  }

  .poignee:active .poignee-trait {
    scale: 1.2 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .poignee:hover .poignee-trait {
      scale: 1.2 1;
    }
  }

  @media (min-width: 600px) {
    .grille {
      padding-inline: 24px;
    }

    .pied {
      padding-inline: 24px;
    }

    .je-donne {
      justify-self: center;
      gap: var(--espace-4);
      min-width: 20rem;
    }

    .tuiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tuiles li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (min-width: 900px) {
    .grille {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--espace-5) var(--espace-4);
      padding: var(--espace-5) 40px var(--espace-6);
    }

    .explorer,
    .acces {
      grid-column: span 3;
    }

    .tuiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tuiles li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .cartes-pliables {
      grid-column: 1 / -1;
    }

    .sofia {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: var(--espace-1) var(--espace-4);
    }

    .sofia > :global(.recherche) {
      flex: 1 1 24rem;
    }

    /* Liens au niveau du champ (l'étiquette du champ est au-dessus) */
    .sofia-liens {
      margin: 0;
      padding-bottom: 0.25rem;
    }
  }

  /* Bureau : la barre porte déjà les pages et « Je donne » ; la feuille ne
     prend que la hauteur de son contenu, sous le voile */
  @media (min-width: 1200px) {
    .feuille {
      height: auto;
      max-height: calc(100dvh - var(--haut-menu));
    }

    .grille {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      align-items: start;
      gap: var(--espace-4);
      padding: var(--espace-5) 64px;
    }

    .explorer,
    .cartes-pliables,
    .donner,
    .pied {
      display: none;
    }

    /* La recherche Sofia sur toute la largeur, puis les services (3
       colonnes : onglets, aperçu) et l'accès rapide (1 colonne, à côté de
       l'aperçu). L'ordre du HTML (Sofia, services, accès rapide) suit
       l'ordre visuel. */
    .sofia {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    /* Services en rangée, puis l'aperçu dessous */
    .catalogue {
      display: grid;
      grid-column: 1 / span 3;
      grid-row: 2 / span 2;
      grid-template-columns: minmax(0, 1fr);
      /* Rangées de la grille (onglets, aperçu) : l'accès rapide s'aligne
         sur l'aperçu */
      grid-template-rows: subgrid;
    }

    /* Liens de l'aperçu sur deux colonnes : l'aperçu prend la hauteur de
       l'accès rapide, à côté ; trois colonnes y laissaient un grand vide */
    .apercu-liens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--espace-4);
    }

    /* Accès rapide : quatre tuiles carrées (2 × 2) à droite de l'aperçu,
       hauts alignés (même rangée de grille). Le surtitre n'est plus
       affiché (les tuiles parlent d'elles-mêmes) mais nomme toujours la
       liste pour les lecteurs d'écran. */
    .acces {
      --i: 2;
      --ecart-tuiles: var(--espace-2);

      display: grid;
      grid-column: 4;
      grid-row: 3;
    }

    .acces .surtitre {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .tuiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tuiles a {
      /* Carré, qui grandit si le libellé (ou le texte agrandi) l'exige */
      aspect-ratio: 1;
      min-height: auto;
      padding: var(--espace-3) 0.75rem 0.75rem;
    }

    /* Icône en haut, libellé en bas, coupé entre les mots seulement */
    .tuile-libelle {
      margin-top: auto;
      overflow-wrap: break-word;
    }

    .tuiles li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (forced-colors: active) {
    .service[aria-selected='true'] {
      outline: 2px solid Highlight;
    }

    .tuiles a,
    .apercu-appel,
    .je-donne {
      border: 1px solid CanvasText;
    }

    .pages a[aria-current='page'] {
      text-decoration: underline;
    }
  }
</style>
