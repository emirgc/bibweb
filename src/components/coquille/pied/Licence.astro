---
/*
 * Mention de licence CC BY 4.0 du pied de page (Copyright de FooterTail).
 * Rendue deux fois par PiedDePage (en tête de ligne sur grand écran, en
 * dernier sur mobile) plutôt que déplacée avec `order` : l'ordre du focus
 * suit ainsi l'ordre visuel (WCAG 2.4.3).
 *
 * Les attributs xmlns:cc et xmlns:dct de la source ne sont pas valides en
 * HTML : le préfixe RDFa passe par `prefix`. Le lien n'ouvre plus un nouvel
 * onglet : c'est une page du site, et rien ne l'annonçait.
 *
 * Libellé court (« Sauf indication contraire : CC BY 4.0 ») : la longue
 * phrase de la source faisait passer la barre du bas sur deux lignes ; les
 * conditions d'utilisation, au bout du lien, donnent le détail. Les logos
 * CC, décoratifs, sont hors du lien : il ne porte que sur le texte.
 */
interface Props {
  class?: string
}

const { class: classe } = Astro.props
---

<div class:list={['licence', classe]} prefix="cc: http://creativecommons.org/ns# dct: http://purl.org/dc/terms/">
  <svg class="icone-cc" xmlns="http://www.w3.org/2000/svg" viewBox="5.5 -3.5 64 64" aria-hidden="true" focusable="false">
    <path d="M37.441-3.5q13.428 0 22.857 9.372 4.513 4.514 6.857 10.314 2.343 5.8 2.344 12.314-.001 6.572-2.314 12.313-2.315 5.743-6.828 10.143-4.684 4.628-10.629 7.086-5.942 2.457-12.285 2.457c-6.343 0-8.276-.808-12.143-2.429q-5.8-2.428-10.4-7.027t-7-10.372C5.5 34.899 5.5 32.767 5.5 28.5q0-6.343 2.428-12.2t7.057-10.486Q24.127-3.499 37.441-3.5m.116 5.772q-10.971 0-18.458 7.657-3.772 3.829-5.8 8.6a25.2 25.2 0 0 0-2.029 9.972q-.001 5.144 2.029 9.913 2.029 4.774 5.8 8.516t8.515 5.715a25.7 25.7 0 0 0 9.943 1.971q5.14.001 9.973-1.999 4.827-2.001 8.713-5.771 7.485-7.313 7.484-18.344 0-5.314-1.943-10.057-1.941-4.742-5.654-8.458-7.718-7.715-18.573-7.715m-.401 20.915-4.287 2.229q-.686-1.428-1.685-2-1-.57-1.858-.571-4.285 0-4.286 5.657 0 2.57 1.085 4.113 1.086 1.544 3.201 1.544 2.8 0 3.944-2.743l3.942 2q-1.257 2.344-3.486 3.686-2.227 1.343-4.914 1.343-4.286.001-6.915-2.629-2.628-2.628-2.628-7.313 0-4.571 2.657-7.257t6.715-2.686q5.944-.002 8.515 4.627m18.457 0-4.229 2.229q-.686-1.427-1.686-2-1.003-.57-1.914-.571-4.286 0-4.287 5.657 0 2.57 1.086 4.113 1.084 1.544 3.201 1.544 2.799 0 3.941-2.743l4 2q-1.314 2.344-3.541 3.686a9.23 9.23 0 0 1-4.857 1.343q-4.343.001-6.941-2.629-2.603-2.628-2.602-7.313 0-4.571 2.658-7.257 2.655-2.685 6.713-2.686 5.944-.002 8.458 4.627"></path>
  </svg>
  <svg class="icone-cc" xmlns="http://www.w3.org/2000/svg" viewBox="5.5 -3.5 64 64" aria-hidden="true" focusable="false">
    <path d="M37.443-3.5q13.483 0 22.742 9.257Q69.499 15.072 69.5 28.5q0 13.486-9.145 22.456Q50.641 60.5 37.443 60.5q-12.973 0-22.514-9.43Q5.501 41.642 5.5 28.5t9.429-22.742Q24.186-3.501 37.443-3.5m.114 5.772q-10.914 0-18.457 7.657-7.83 8.001-7.829 18.572 0 10.63 7.77 18.398 7.771 7.772 18.514 7.771 10.685.002 18.629-7.828 7.543-7.257 7.543-18.343 0-10.913-7.656-18.571-7.656-7.656-18.514-7.656m8.572 18.285v13.085h-3.656v15.542h-9.944V33.643h-3.656V20.557q0-.857.599-1.457.602-.6 1.457-.6h13.144q.8 0 1.428.6t.628 1.457m-13.087-8.228q0-4.513 4.458-4.514c4.458-.001 4.457 1.504 4.457 4.514q0 4.457-4.457 4.457c-4.457 0-4.458-1.486-4.458-4.457"></path>
  </svg>
  <a href="/conditions-utilisation/" rel="license">Sauf indication contraire : CC BY 4.0</a>
</div>

<style>
  .licence {
    display: inline-flex;
    align-items: center;
    font: inherit;
  }

  /* 24 px de haut au moins (WCAG 2.5.8) : 17 px de texte + 2 × 4 px */
  a {
    display: inline-block;
    padding-block: 4px;
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: inherit;
    text-decoration: underline;
  }

  /* Le bleu du focus global se perd sur les fonds bleus du pied de page */
  a:focus-visible {
    outline-color: var(--couleur-surface);
  }

  /* 1ex de la taille d'icône de MUI (1.5rem), comme SvgIcon dans la source */
  .icone-cc {
    display: inline-block;
    font-size: 1.5rem;
    width: 1ex;
    height: 1ex;
    margin-right: 4px;
    fill: currentColor;
  }
</style>
