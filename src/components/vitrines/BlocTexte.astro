---
/*
 * Bloc « texte » : titre, texte et rangée de boutons qui passe à la ligne
 * (enseignement : ressources éducatives libres). Comme dans les héros :
 * --espace-bloc entre le texte et les boutons, --espace-element entre eux,
 * dans la colonne de texte (GridOffset 0.5).
 */
import GridOffset from '@/components/mdx/primitives/GridOffset.astro'
import Button from '@/components/mdx/primitives/Button.astro'
import Titre from './Titre.astro'
import TexteMarkdown from './TexteMarkdown.astro'
import type { BlocDe } from './types'

type Props = { bloc: BlocDe<'texte'> }

const { bloc } = Astro.props
---

<GridOffset offset={0.5}>
  <Titre texte={bloc.titre} id={bloc.id} />
  {bloc.texte && <TexteMarkdown texte={bloc.texte} espacerParagraphes />}
  {
    bloc.boutons && (
      <div class="boutons">
        {bloc.boutons.map((bouton) => (
          <Button href={bouton.lien} primary={!bouton.secondaire} secondary={bouton.secondaire} variant={bouton.contour ? 'outlined' : undefined}>
            {bouton.texte}
          </Button>
        ))}
      </div>
    )
  }
</GridOffset>

<style>
  .boutons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-element);
    margin-top: var(--espace-bloc);
  }

  .boutons > :global(.bouton) {
    margin: 0;
  }
</style>
