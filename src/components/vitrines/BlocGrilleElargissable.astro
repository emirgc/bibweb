---
/*
 * Bloc « grille-elargissable » (accueil, « Mille et une façons
 * d'apprendre ») : titre, texte, cartes à icône compactes en rangées de
 * deux dès 600 px (GrilleElargissable), puis un bouton centré. Marges de la
 * source : 2,5rem au-dessus de la grille et du bouton.
 */
import GrilleElargissable from '@/components/mdx/cartes/GrilleElargissable.astro'
import CardWithIcon from '@/components/mdx/cartes/CardWithIcon.astro'
import Button from '@/components/mdx/primitives/Button.astro'
import Titre from './Titre.astro'
import TexteMarkdown from './TexteMarkdown.astro'
import { composantIcone } from '@/lib/icones'
import type { BlocDe } from './types'

type Props = { bloc: BlocDe<'grille-elargissable'> }

const { bloc } = Astro.props
const icones = await Promise.all(bloc.cartes.map((carte) => composantIcone(carte.icone)))
---

<Titre texte={bloc.titre} id={bloc.id} />
{bloc.texte && <TexteMarkdown texte={bloc.texte} brut />}
<GrilleElargissable style={{ marginTop: '2.5rem' }}>
  {bloc.cartes.map((carte, i) => <CardWithIcon fullWidth color={bloc.couleurCartes} title={carte.titre} Icon={icones[i]} moreText={carte.appel} href={carte.lien} />)}
</GrilleElargissable>
{
  bloc.bouton && (
    <div class="pied-bloc">
      <Button href={bloc.bouton.lien} primary={!bloc.bouton.secondaire} secondary={bloc.bouton.secondaire}>
        {bloc.bouton.texte}
      </Button>
    </div>
  )
}

<style>
  /* Bouton centré sous la grille */
  .pied-bloc {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
</style>
