---
/*
 * Bloc « carrousel-images » : titre, texte et carrousel (Carousel1) de
 * cartes-liens à photo (CardWithImage), titres en h3.
 */
import Carousel1 from '@/components/mdx/mise-en-page/Carousel1.astro'
import CardWithImage from '@/components/mdx/cartes/CardWithImage.astro'
import Titre from './Titre.astro'
import TexteMarkdown from './TexteMarkdown.astro'
import type { BlocDe } from './types'

type Props = { bloc: BlocDe<'carrousel-images'> }

const { bloc } = Astro.props
---

<Carousel1>
  <Titre slot="title" texte={bloc.titre} id={bloc.id} />
  {bloc.texte && <TexteMarkdown slot="description" texte={bloc.texte} espacerParagraphes />}
  {bloc.cartes.map((carte) => <CardWithImage title={carte.titre} Image={carte.image} href={carte.lien} moreText={carte.appel} />)}
</Carousel1>
