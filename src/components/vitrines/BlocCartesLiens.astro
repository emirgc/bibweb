---
/*
 * Bloc « cartes-liens » (nous-joindre) : grille de cartes-liens bleues à
 * icône (Card2), de même hauteur, --espace-grille entre elles (.62rem et
 * 4rem de marges dans la source). Une colonne, deux dès 600 px, trois dès
 * 900 px, puis toutes les cartes sur une rangée (quatre ou cinq) quand la
 * zone des cartes fait 1312 px ou plus : requête de conteneur, qui équivaut à
 * un écran de 1440 px sans ajouter de seuil à la page. Avec cinq cartes,
 * 3 + 2 en dessous.
 */
import Card2 from '@/components/mdx/cartes/Card2.astro'
import { composantIcone } from '@/lib/icones'
import type { BlocDe } from './types'

type Props = { bloc: BlocDe<'cartes-liens'> }

const { bloc } = Astro.props
const icones = await Promise.all(bloc.cartes.map((carte) => composantIcone(carte.icone)))
---

<div class="zone-cartes">
  <ul class="cartes-liens" style={`--n: ${bloc.cartes.length}`} id={bloc.id} data-revelation="groupe">
    {
      bloc.cartes.map((carte, i) => (
        <li>
          <Card2 title={carte.titre} Icon={icones[i]} href={carte.lien} />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .zone-cartes {
    container-type: inline-size;
  }

  .cartes-liens {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-grille);
    margin-block: var(--espace-bloc);
    padding: 0;
    list-style: none;
  }

  .cartes-liens > li {
    display: flex;
  }

  /* La carte suit sa colonne : ses 250 px minimum (Card2) la faisaient
     déborder sur sa voisine quand la colonne était plus étroite */
  .cartes-liens > li > :global(*) {
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (min-width: 600px) {
    .cartes-liens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .cartes-liens {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .cartes-liens {
      gap: var(--espace-4);
    }
  }

  /* Une rangée seulement quand chaque carte garde au moins 15rem : en
     dessous, les cartes se serraient (193 px à 1200 px). 1312 px : largeur de
     la zone à 1440 px d'écran (mesurée). */
  @container (width >= 1312px) {
    .cartes-liens {
      grid-template-columns: repeat(min(var(--n), 5), minmax(0, 1fr));
    }
  }
</style>
