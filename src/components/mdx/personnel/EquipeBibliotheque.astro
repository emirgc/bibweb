---
/*
 * Équipe d'une bibliothèque (page d'une bibliothèque, bloc « personnel ») :
 * une rangée de vignettes, photo, nom et fonction, qui mènent chacune à la
 * fiche complète de la personne dans le répertoire (/nous-joindre/notre-equipe/
 * filtré sur son nom, comme les résultats « Personnel » de la recherche).
 *
 * Les membres sont ceux dont la colonne « bibliothèque » du tableur nomme la
 * bibliothèque (son titre, son nom complet, son sigle ou son ancre) ; la
 * colonne « direction », partagée avec d'autres bibliothèques, n'est pas lue.
 * `ordre` (noms complets) place ces personnes en tête, dans cet ordre ; les
 * autres suivent par ordre alphabétique. Un nom absent de l'équipe fait
 * échouer le build : une faute de frappe ne passe pas inaperçue.
 *
 * Un seul lien par vignette, sur le nom : son ::after couvre la vignette.
 * La photo est décorative (alt vide), le nom est juste dessous.
 */
import { Picture } from 'astro:assets'
import { personnel, urlFichePersonne } from '@/lib/personnel'
import { bibliotheques } from '@/data/bibliotheques'
import { cle, majuscule } from './normaliser'
import { photoDe } from './photos'

interface Props {
  /** Ancre de la fiche de la bibliothèque (src/data/horaires/lieux.ts), comme `lrcs` */
  bibliotheque: string
  /** Noms complets dans l'ordre d'affichage */
  ordre?: string[]
  /** Niveau du nom de chaque personne (3 : sous un titre ##) */
  niveauTitre?: 3 | 4 | 5
}

const { bibliotheque, ordre = [], niveauTitre = 3 } = Astro.props
const bib = bibliotheques.find((b) => b.id === bibliotheque)
if (!bib) throw new Error(`EquipeBibliotheque : aucune bibliothèque « ${bibliotheque} » dans src/data/horaires/lieux.ts`)
const noms = new Set([bib.id, bib.titre, bib.autreTitre, ...bib.alias].map(cle))
const equipe = personnel().filter((p) => p.bibliotheques.some((b) => noms.has(cle(b))))
const rangs = ordre.map((nom) => {
  const i = equipe.findIndex((p) => cle(p.nomComplet) === cle(nom))
  if (i < 0) throw new Error(`EquipeBibliotheque : « ${nom} » n'est pas dans l'équipe de ${bib.autreTitre} (${equipe.map((p) => p.nomComplet).join(', ')})`)
  return equipe[i]
})
const membres = [...rangs, ...equipe.filter((p) => !rangs.includes(p))]
const Titre = `h${niveauTitre}` as 'h3'
---

<ul class="equipe" aria-label={`Équipe : ${bib.autreTitre}`}>
  {
    membres.map((p) => {
      const photo = photoDe(p)
      return (
        <li class="vignette">
          {photo && <Picture class="photo" src={photo} alt="" width={160} height={160} densities={[1, 2]} fit="cover" position="center" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" decoding="async" />}
          <Titre class="nom">
            <a href={urlFichePersonne(p)}>{p.nomComplet}</a>
          </Titre>
          <p class="fonction">{majuscule(p.fonction)}</p>
        </li>
      )
    })
  }
</ul>

<style>
  /* Deux par rangée sur un téléphone : une seule colonne allongeait la page
     d'une vignette par personne. Largeur minimale en rem : avec le texte
     agrandi, une seule colonne plutôt que des noms qui débordent (WCAG
     1.4.10) */
  .equipe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--espace-grille);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vignette {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: var(--espace-carte) var(--espace-element);
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-carte);
    background-color: var(--couleur-surface);
    text-align: center;
    transition:
      border-color var(--duree-courte-4) var(--courbe-standard),
      box-shadow var(--duree-courte-4) var(--courbe-standard);
  }

  @media (min-width: 600px) {
    .equipe {
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    }

    .vignette :global(.photo) {
      width: 7.5rem;
      height: 7.5rem;
    }
  }

  .vignette:hover {
    border-color: var(--couleur-lien);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--bleu-fonce) 12%, transparent);
  }

  /* Le focus du lien s'affiche sur toute la vignette */
  .vignette:has(a:focus-visible) {
    outline: 3px solid var(--couleur-focus);
    outline-offset: 2px;
  }

  .vignette :global(.photo) {
    width: 5.5rem;
    height: 5.5rem;
    margin-block-end: 0.25rem;
    border-radius: var(--rayon-plein);
    object-fit: cover;
  }

  .nom,
  .fonction {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .nom {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: var(--graisse-forte);
    line-height: 1.3;
  }

  .nom a {
    color: var(--couleur-texte);
    text-decoration: none;
  }

  .nom a:focus-visible {
    outline: none;
  }

  .nom a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--rayon-carte);
  }

  .vignette:hover .nom a {
    color: var(--couleur-lien);
    text-decoration: underline;
  }

  .fonction {
    margin: 0;
    color: var(--couleur-texte-secondaire);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  @media (forced-colors: active) {
    .vignette:has(a:focus-visible) {
      outline-color: Highlight;
    }
  }
</style>
