---
/*
 * Volet d'accordéon (Accordion de coquille-web) en <details> natif : il
 * s'ouvre au clavier et sans JavaScript. Dans un AccordionGroup, il reçoit le
 * `name` du groupe (un seul volet ouvert à la fois, comme dans la source).
 * Hors groupe, il fonctionne seul (la source plantait).
 *
 * Fond de page et texte foncé, comme le Paper de la source, même posé dans
 * une Section foncée (d'où surface-claire).
 *
 * Une ancre qui vise le volet ou un élément de son contenu l'ouvre, au
 * chargement comme au changement de hash : le petit script ci-dessous.
 *
 * Ouverture et fermeture animées par ::details-content et interpolate-size
 * (hauteur et opacité) là où les deux existent ; ailleurs, le contenu
 * apparaît en fondu (AccordionDetails) et se ferme d'un coup. La hauteur est
 * la seule exception à « transform et opacity » : rien d'autre ne fait
 * glisser le contenu qui suit. Une ouverture par ancre n'est pas animée,
 * pour que la cible soit en place tout de suite.
 */
import { classes, fusionnerStyles, type Style } from '@/lib/styles'

interface Props {
  /** Ouvert au premier affichage ; dans un groupe, le premier l'emporte */
  defaultExpanded?: boolean | string
  id?: string
  class?: string
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { defaultExpanded = false, class: classe, className, style, sx: _sx, ...reste } = Astro.props
const ouvert = defaultExpanded === true || defaultExpanded === '' || defaultExpanded === 'true'
---

<details
  class:list={['accordeon', 'surface-claire', classes(classe, className)]}
  style={fusionnerStyles(style)}
  open={ouvert || undefined}
  data-accordeon
  data-accordeon-groupe=""
  {...reste}
>
  <slot />
</details>

<script>
  // Ouvre les volets qui contiennent la cible de l'ancre, puis la ramène en
  // vue : ouvrir un volet après le saut décale la page.
  function ouvrirSelonAncre() {
    const id = decodeURIComponent(location.hash.slice(1))
    const cible = id ? document.getElementById(id) : null
    if (!cible) return
    let volet = cible.closest<HTMLDetailsElement>('details[data-accordeon]')
    let change = false
    while (volet) {
      if (!volet.open) {
        volet.classList.add('sans-transition')
        volet.open = true
        change = true
      }
      volet = volet.parentElement?.closest<HTMLDetailsElement>('details[data-accordeon]') ?? null
    }
    if (change)
      requestAnimationFrame(() => {
        // Saut immédiat : le défilement doux de html ferait traverser la page
        cible!.scrollIntoView({ behavior: 'instant' })
        requestAnimationFrame(() => document.querySelectorAll('details.sans-transition').forEach((d) => d.classList.remove('sans-transition')))
      })
  }

  ouvrirSelonAncre()
  window.addEventListener('hashchange', ouvrirSelonAncre)
</script>

<style>
  .accordeon {
    background-color: var(--couleur-fond);
  }

  @supports (interpolate-size: allow-keywords) and selector(::details-content) {
    .accordeon {
      interpolate-size: allow-keywords;
    }

    /* Court : la hauteur coûte une mise en page à chaque image. Sans
       content-visibility en allow-discrete, le contenu disparaîtrait avant
       la fin de la fermeture. */
    .accordeon::details-content {
      block-size: 0;
      overflow-y: clip;
      opacity: 0;
      transition:
        block-size var(--duree-moyenne-1) var(--courbe-emphase),
        opacity var(--duree-moyenne-1) var(--courbe-emphase),
        content-visibility var(--duree-moyenne-1) allow-discrete;
    }

    .accordeon[open]::details-content {
      block-size: auto;
      opacity: 1;
    }

    .accordeon.sans-transition::details-content {
      transition: none;
    }
  }

  /* Ouverture par une ancre : titre et indicateur aussi, sans transition */
  .accordeon.sans-transition :global(.sommaire),
  .accordeon.sans-transition :global(.sommaire *),
  .accordeon.sans-transition :global(.sommaire *::after) {
    transition: none;
  }

  /* Impression : pas d'état intermédiaire figé */
  @media print {
    .accordeon::details-content {
      transition: none;
    }
  }
</style>
