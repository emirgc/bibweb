---
/*
 * Appel à l'action : texte et image côte à côte (HeroWithImage de
 * coquille-web), dans une colonne décalée d'une demi-colonne de chaque côté.
 *
 * Dès 900 px : texte 5/12, espace 1/12, image 6/12, centrés verticalement ;
 * `align="right"` met l'image à gauche. En dessous : une seule colonne
 * (l'image d'abord avec align="right"), et le pied (`footer`) passe sous
 * l'image. Le pied n'est rendu qu'une fois : sa colonne devient `display:
 * contents` sur mobile et il y passe en dernier (`order`), au lieu des deux
 * rendus de la source selon useSmall.
 *
 * Espacements communs à tous les héros (HeroWithText, HeroWithText2,
 * blocs image-texte et icone-texte) : --espace-titre sous le titre,
 * --espace-bloc entre le texte et les boutons et entre les parties
 * empilées sur mobile, --espace-element entre les boutons. Les marges
 * propres au contenu (titre, dernier paragraphe, Button) sont neutralisées
 * pour que ces écarts soient exacts.
 *
 * `compact` (image-texte des pages de texte) : sous 900 px, l'image devient
 * une vignette carrée à côté du premier élément (le titre), au lieu d'une
 * pleine largeur au-dessus ou au-dessous du texte ; une page qui en enchaîne
 * une douzaine (nos-collections-speciales) ne s'allonge plus d'autant.
 *
 * L'image est décorative (alt="" dans la source).
 */
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import RenduJsx from '@/components/partage/RenduJsx.astro'
import GridOffset from '@/components/mdx/primitives/GridOffset.astro'
import { classes, fusionnerStyles, type Style } from '@/lib/styles'

interface Props {
  align?: 'left' | 'right'
  Image: ImageMetadata | string
  imageWidth?: number
  imageHeight?: number
  /** Pied (bouton) ; aussi possible en slot « footer » */
  footer?: unknown
  /** Vignette à côté du titre sous 900 px (voir plus haut) */
  compact?: boolean
  class?: string
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { align = 'left', Image, imageWidth, imageHeight, footer, compact = false, class: classe, className, style, sx: _sx, ...reste } = Astro.props
if (align !== 'left' && align !== 'right') throw new Error(`HeroWithImage : align « ${align} » invalide (left ou right).`)
if (Image === undefined) throw new Error('HeroWithImage : la propriété `Image` est requise.')
// Un slot « footer » posé mais vide ne compte pas (voir HeroWithText)
const aPied = footer !== undefined || (Astro.slots.has('footer') && (await Astro.slots.render('footer')).trim() !== '')
---

<GridOffset offset={0.5} class={classes('hero-avec-image', classe, className)} style={fusionnerStyles(style)} {...reste}>
  <div class:list={['rangee', `image-${align === 'left' ? 'droite' : 'gauche'}`, { compact }]} data-revelation="groupe">
    <div class="colonne-texte">
      <div class="contenu"><slot /></div>
      {
        aPied && (
          <div class="pied">
            <slot name="footer"><RenduJsx valeur={footer} /></slot>
          </div>
        )
      }
    </div>
    <div class="colonne-image">
      {
        typeof Image === 'string' ? (
          <img src={Image} width={imageWidth} height={imageHeight} alt="" loading="lazy" decoding="async" />
        ) : (
          <Picture src={Image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 768, 1024, 1536].filter((l) => l < Image.width).concat(Math.min(Image.width, 1536))} sizes="(min-width: 1536px) 690px, (min-width: 900px) 46vw, 92vw" alt="" loading="lazy" />
        )
      }
    </div>
  </div>
</GridOffset>

<style>
  .rangee {
    display: flex;
    flex-direction: column;
    gap: var(--espace-bloc);
    width: 100%;
  }

  .colonne-texte {
    display: contents;
  }

  /* Le titre et le dernier élément du texte n'ajoutent pas leur marge aux
     écarts du héros */
  .contenu > :global(:first-child) {
    margin-top: 0;
  }

  .contenu > :global(:is(h2, h3, h4):first-child) {
    margin-block: 0 var(--espace-titre);
  }

  .contenu > :global(:last-child) {
    margin-bottom: 0;
  }

  .pied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-element);
    order: 1;
  }

  .pied > :global(*),
  .pied :global(.bouton) {
    margin: 0;
  }

  .colonne-image {
    display: flex;
    justify-content: center;
  }

  /* Sur mobile, l'image (décorative) vient d'abord quand elle est à gauche ;
     dès 900 px, la grille place les colonnes explicitement */
  .image-gauche .colonne-image {
    order: -1;
  }

  .colonne-image :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--rayon-petit);
  }

  /* ---- Compact (sous 900 px) : vignette à droite du premier élément ---- */
  .compact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem;
    column-gap: var(--espace-element);
    row-gap: 0;
  }

  .compact .contenu {
    display: contents;
  }

  .compact .contenu > :global(*) {
    grid-column: 1 / -1;
  }

  /* Le titre se cale sur le bas de la vignette : l'écart titre → texte reste
     --espace-titre, quelle que soit la hauteur du titre */
  .compact .contenu > :global(:first-child) {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
  }

  .compact .colonne-image {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    margin-bottom: var(--espace-titre);
  }

  .compact .colonne-image :global(img) {
    width: 6.5rem;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .compact .pied {
    grid-column: 1 / -1;
    margin-top: var(--espace-bloc);
  }

  @media (min-width: 900px) {
    .rangee,
    .compact {
      display: grid;
      align-items: center;
      gap: 0;
    }

    .image-droite {
      grid-template-columns: 5fr 1fr 6fr;
    }

    .image-gauche {
      grid-template-columns: 6fr 1fr 5fr;
    }

    .colonne-texte,
    .compact .contenu {
      display: block;
    }

    .image-droite .colonne-texte {
      grid-column: 1;
    }

    .image-droite .colonne-image {
      grid-column: 3;
      grid-row: 1;
    }

    .image-gauche .colonne-texte {
      grid-column: 3;
      grid-row: 1;
    }

    .image-gauche .colonne-image {
      grid-column: 1;
      grid-row: 1;
    }

    .compact .colonne-image {
      align-self: center;
      margin-bottom: 0;
    }

    .compact .colonne-image :global(img) {
      width: auto;
      aspect-ratio: auto;
    }

    .pied,
    .compact .pied {
      margin-top: 0;
      padding-top: var(--espace-bloc);
    }
  }
</style>
