---
/*
 * Liste riche (RichList de coquille-web) : liste sans puces, décalée de
 * `offset` colonnes de chaque côté (0.5 par défaut). Ses éléments sont des
 * RichListItemWithLink.
 */
import GridOffset from '@/components/mdx/primitives/GridOffset.astro'
import { classes, fusionnerStyles, type Style } from '@/lib/styles'

interface Props {
  offset?: number
  /** Passé dans le contenu (etudes) mais ignoré, comme dans la source */
  bg?: string
  class?: string
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { offset = 0.5, bg: _bg, class: classe, className, style, ...reste } = Astro.props
---

<GridOffset offset={offset} class={classes('bib-comp-rich-list', classe, className)} style={fusionnerStyles(style)} {...reste}>
  <ul class="liste-riche" data-revelation="groupe">
    <slot />
  </ul>
</GridOffset>

<style>
  .liste-riche {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
