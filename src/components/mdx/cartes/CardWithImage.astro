---
/*
 * Carte-lien avec photo (CardWithImage de coquille-web).
 *
 * 330 × 500 px : photo de 220 px en cover, titre de style h4 limité à trois
 * lignes, texte d'appel et pastille fléchée en bas. Corrigés :
 * - un seul lien, sur le titre, dont le ::after couvre la carte ; nom
 *   accessible = titre ; moreText devient sa description et n'est pas relu ;
 * - la photo est décorative (alt="") : son alt valait le titre, lu deux fois ;
 * - les flèches étaient inversées (interne ↗, externe →) et choisies après
 *   l'hydratation ;
 * - le titre était un h4 en dur : niveauTitre (3 par défaut) fixe la balise,
 *   l'apparence reste celle du h4.
 * Texte et flèche bleu principal sur le fond : 6,8:1.
 */
import type { ImageMetadata } from 'astro'
import { Image as ImageAstro } from 'astro:assets'
import RenduJsx from '@/components/partage/RenduJsx.astro'
import { classes, fusionnerStyles, type Style } from '@/lib/styles'
import { lienCarte } from '@/lib/liens'
import { idUnique } from '@/lib/ids'

interface Props {
  title: unknown
  Image: ImageMetadata | string
  href: string
  moreText?: unknown
  /** Texte de remplacement de la photo ; décorative par défaut */
  alt?: string
  niveauTitre?: 2 | 3 | 4 | 5 | 6
  target?: string
  rel?: string
  id?: string
  class?: string
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { title, Image, href, moreText = 'En savoir plus', alt = '', niveauTitre = 3, target, rel, class: classe, className, style, sx: _sx, ...reste } = Astro.props

if (title === undefined) throw new Error('CardWithImage : la propriété `title` est obligatoire.')
if (!Image) throw new Error('CardWithImage : la propriété `Image` est obligatoire.')
if (typeof href !== 'string') throw new Error('CardWithImage : la propriété `href` doit être une chaîne.')

const { interne, rel: relFinal, annonce } = lienCarte(href, target, rel)
const idPlus = moreText ? idUnique('carte-plus') : undefined
const Titre = `h${niveauTitre}`
---

<div class:list={['carte', 'surface-claire', classes(classe, className)]} style={fusionnerStyles(style)} {...reste}>
  {
    typeof Image === 'string' ? (
      <img class="photo" src={Image} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <ImageAstro class="photo" src={Image} alt={alt} widths={[330, 660]} sizes="330px" formats={['avif', 'webp']} loading="lazy" />
    )
  }
  <div class="contenu">
    <Titre class="titre">
      <a class="lien-carte" href={href} target={target} rel={relFinal} aria-describedby={idPlus}
        >{typeof title === 'string' ? title : <RenduJsx valeur={title} />}{annonce && <span class="visuellement-masque">{annonce}</span>}</a
      >
    </Titre>
    <div class="pied">
      {
        moreText && (
          <div class="plus" id={idPlus} aria-hidden="true">
            {typeof moreText === 'string' ? moreText : <RenduJsx valeur={moreText} />}
          </div>
        )
      }
      <svg class:list={['fleche', { externe: !interne }]} viewBox="0 0 50 51" width="50" height="51" aria-hidden="true" focusable="false">
        <rect width="50" height="50" x="0" y="0.5" rx="25" opacity=".1"></rect>
        {interne ? <path d="m34.508 25.415-7.031 7.031a.586.586 0 0 1-.828-.828l6.03-6.031H16.907a.586.586 0 1 1 0-1.172h15.772l-6.03-6.031a.586.586 0 0 1 .828-.828l7.031 7.03a.586.586 0 0 1 0 .829z" /> : <path d="m32.163 18.924 7.1e-5 9.9437c-0.0054 0.15175-0.06944 0.29543-0.17869 0.40086-0.10918 0.1055-0.25512 0.16447-0.40694 0.1644-0.15182 7e-5 -0.29776-0.0589-0.40694-0.1644-0.10925-0.10543-0.17331-0.24911-0.17869-0.40086l-6.37e-4 -8.5288-11.153 11.153c-0.10988 0.10988-0.25887 0.17162-0.41429 0.17162s-0.30441-0.06173-0.41429-0.17162-0.17169-0.25894-0.17169-0.41436c7.1e-5 -0.15535 0.06173-0.30441 0.17162-0.41429l11.153-11.153-8.5288-6.37e-4c-0.15175-0.0054-0.29543-0.06944-0.40086-0.17869-0.1055-0.10918-0.1644-0.25505-0.1644-0.40694-7e-5 -0.15182 0.05897-0.29769 0.1644-0.40694 0.10543-0.10925 0.24911-0.17331 0.40086-0.17869l9.9437 7.1e-5c0.15528 1.42e-4 0.3042 0.0618 0.41401 0.17162 0.10974 0.10974 0.17147 0.25873 0.17154 0.41394z" />}
      </svg>
    </div>
  </div>
</div>

<style>
  .carte {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 330px;
    /* Jamais plus large que sa colonne (320 px, WCAG 1.4.10) */
    max-width: 100%;
    /* Hauteur minimale (voir CardWithIcon) : la carte grandit avec le texte
       agrandi au lieu de le rogner */
    min-height: 500px;
    overflow: hidden;
    border-radius: var(--rayon-carte);
    background-color: var(--couleur-fond);
  }

  /* Focus sur toute la carte ; liseré blanc puis contour, lisible sur tout fond */
  .carte:has(.lien-carte:focus-visible) {
    overflow: visible;
    outline: 3px solid var(--couleur-focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--couleur-surface);
  }

  .lien-carte:focus-visible {
    outline: none;
  }

  .photo {
    display: block;
    flex-shrink: 0;
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-start-start-radius: inherit;
    border-start-end-radius: inherit;
  }

  .contenu {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    /* Marge réduite (et non --espace-carte) : la photo prend 220 px sur 500 et
       le titre a jusqu'à trois lignes */
    padding: var(--espace-element);
  }

  /* Apparence du h4 du thème, quelle que soit la balise. Plus de limite à
     trois lignes : le titre entier reste lisible avec le texte agrandi */
  .titre {
    margin: 0.5em 0 0.5rem;
    font-family: var(--police-serif);
    /* Chiffres tabulaires désactivés : dans Lora, ils élargissent aussi
       l'espace entre les mots (16,7 px au lieu de 10,5 px à 40 px). */
    font-variant-numeric: lining-nums proportional-nums;
    font-size: 1.25rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  @media (min-width: 900px) {
    .titre {
      font-size: 1.875rem;
    }
  }

  .lien-carte {
    color: inherit;
    text-decoration: none;
  }

  .lien-carte::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--rayon-carte);
  }

  .pied {
    display: flex;
    align-items: center;
    margin-top: auto;
    color: var(--couleur-lien);
  }

  .plus {
    flex-grow: 1;
    font-size: 1rem;
  }

  .fleche {
    flex-shrink: 0;
    fill: currentColor;
  }

  /* Survol et focus : la flèche avance d'un cran dans sa pastille
     (transform seulement ; survol réservé aux pointeurs fins) */
  .fleche path {
    transition: transform var(--duree-courte-4) var(--courbe-standard-deceleree);
  }

  @media (hover: hover) and (pointer: fine) {
    .carte:hover .fleche path {
      transform: translateX(3px);
    }

    .carte:hover .externe path {
      transform: translate(2px, -2px);
    }
  }

  .carte:has(.lien-carte:focus-visible) .fleche path {
    transform: translateX(3px);
  }

  .carte:has(.lien-carte:focus-visible) .externe path {
    transform: translate(2px, -2px);
  }

  /* Survol : léger voile, comme le CardActionArea de MUI (opacité 0,04) */
  .carte::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background-color: currentColor;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duree-moyenne-1) var(--courbe-standard);
  }

  .carte:hover::before {
    opacity: 0.04;
  }

  @media (forced-colors: active) {
    .carte {
      border: 1px solid CanvasText;
    }
  }
</style>
