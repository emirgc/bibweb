---
/*
 * Texte typographié (MUI Typography et variantes du thème de coquille-web).
 *
 * `variant` donne l'apparence, `component` la balise : variant="h2"
 * component="h1" rend un <h1> qui a l'apparence d'un h2. Sans component, la
 * balise suit la correspondance de MUI (h1-h6, body → p, autres → span).
 * Corrigés : subtitle1/2 donnaient un <h6> (faux titre) et deviennent des
 * <p> ; variant="p", invalide dans MUI, donne un <p> en body1.
 */
import { classes, fusionnerStyles, type Style } from '@/lib/styles'
import { couleurTheme } from '@/lib/couleurs'

interface Props {
  variant?: string
  component?: string
  gutterBottom?: boolean
  paragraph?: boolean
  noWrap?: boolean
  align?: 'left' | 'center' | 'right' | 'justify' | 'inherit'
  /** text.primary, text.secondary, primary ou nom de la palette */
  color?: string
  id?: string
  class?: string
  className?: string
  style?: Style
  [attribut: string]: unknown
}

const { variant: varianteDemandee = 'body1', component, gutterBottom = false, paragraph = false, noWrap = false, align, color, class: classe, className, style, ...reste } = Astro.props

const variante = varianteDemandee === 'p' || varianteDemandee === 'inherit' ? (varianteDemandee === 'p' ? 'body1' : 'inherit') : varianteDemandee
const BALISES: Record<string, string> = {
  h1: 'h1',
  h2: 'h2',
  h3: 'h3',
  h4: 'h4',
  h5: 'h5',
  h6: 'h6',
  subtitle1: 'p',
  subtitle2: 'p',
  body1: 'p',
  body2: 'p',
  inherit: 'p',
}
const Balise = component ?? (paragraph ? 'p' : BALISES[variante]) ?? 'span'
const styleFinal = fusionnerStyles({ color: couleurTheme(color), textAlign: align && align !== 'inherit' ? align : undefined }, style)
---

<Balise
  class:list={['typo', `typo-${variante}`, { 'marge-bas': gutterBottom, paragraphe: paragraph, 'sans-retour': noWrap }, classes(classe, className)]}
  style={styleFinal}
  {...reste}><slot /></Balise
>

<style>
  .typo {
    margin: 0;
    font-family: var(--police-sans);
    font-style: normal;
    font-feature-settings: 'liga' off, 'clig' off;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .marge-bas {
    margin-bottom: 0.35em;
  }

  .paragraphe {
    margin-bottom: 16px;
  }

  .sans-retour {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- Titres (tailles mobiles, puis dès 900 px) ---- */
  .typo-h1,
  .typo-h2,
  .typo-h3,
  .typo-h4,
  .typo-h4Figtree,
  .typo-h5,
  .typo-h6 {
    margin-block: 0.5em;
    text-wrap: pretty;
  }

  .typo-h1 {
    font-size: 3rem;
    font-weight: var(--graisse-forte);
    line-height: 1.1;
  }

  .typo-h2 {
    font-size: 2.5rem;
    font-weight: var(--graisse-forte);
    line-height: 1.1;
  }

  .typo-h3 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .typo-h4,
  .typo-h4Figtree {
    font-size: 1.25rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.2;
  }

  .typo-h4 {
    font-family: var(--police-serif);
    /* Chiffres tabulaires désactivés : dans Lora, ils élargissent aussi
       l'espace entre les mots (16,7 px au lieu de 10,5 px à 40 px). */
    font-variant-numeric: lining-nums proportional-nums;
  }

  .typo-h5 {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .typo-h6 {
    font-size: 1rem;
    font-weight: var(--graisse-normale);
    line-height: 1.2;
  }

  @media (min-width: 900px) {
    .typo-h1 {
      font-size: 6.875rem;
    }

    .typo-h2 {
      font-size: 3.5rem;
    }

    .typo-h3 {
      font-size: 2.25rem;
      font-weight: var(--graisse-forte);
    }

    .typo-h4,
    .typo-h4Figtree {
      font-size: 1.875rem;
    }

    .typo-h6 {
      font-size: 1.125rem;
    }
  }

  /* ---- Texte ---- */
  .typo-body1,
  .typo-subtitle1 {
    font-size: 1rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.5;
  }

  .typo-body2,
  .typo-subtitle2,
  .typo-button {
    font-size: 0.875rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.5;
  }

  .typo-caption {
    font-size: 0.75rem;
    font-weight: var(--graisse-normale);
    line-height: 1.5;
  }

  .typo-overline {
    font-size: 0.75rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .typo-legal {
    font-size: 0.857rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.2;
  }

  .typo-inherit {
    font: inherit;
  }

  /* ---- Titres de bannière ---- */
  .typo-titreSuperHero,
  .typo-titreSuperHeroSmall {
    font-weight: var(--graisse-forte);
    line-height: 1.1;
  }

  .typo-titreSuperHero {
    padding-bottom: 1rem;
    font-size: 2.5rem;
  }

  .typo-titreSuperHeroSmall {
    padding-bottom: 2.5rem;
    font-size: 2.1rem;
  }

  /* ---- Affichage ---- */
  .typo-display1 {
    font-size: 2.5rem;
    font-weight: var(--graisse-forte);
    line-height: 1;
  }

  .typo-display2 {
    font-size: 2rem;
    line-height: 1.2;
  }

  .typo-display3 {
    font-size: 1.65rem;
    line-height: 1.2;
  }

  .typo-display4 {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .typo-display5 {
    font-size: 1.375rem;
    line-height: 1.2;
  }

  @media (min-width: 600px) {
    .typo-titreSuperHero {
      font-size: 3.75rem;
    }

    .typo-titreSuperHeroSmall {
      font-size: 3rem;
    }

    .typo-display1 {
      font-size: 4rem;
    }

    .typo-display2 {
      font-size: 3rem;
    }
  }

  @media (min-width: 900px) {
    .typo-titreSuperHero {
      font-size: 4.5rem;
    }

    .typo-titreSuperHeroSmall {
      font-size: 3.5rem;
    }

    .typo-display1 {
      font-size: 6.5rem;
    }

    .typo-display2 {
      font-size: 3.5rem;
    }

    .typo-display3 {
      font-size: 2.125rem;
    }

    .typo-display4 {
      font-size: 1.625rem;
    }

    .typo-display5 {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1200px) {
    .typo-titreSuperHeroSmall {
      font-size: 4rem;
    }
  }

  /* ---- Variantes spéciales ---- */
  .typo-carteProfilLink {
    display: flex;
    align-items: center;
    margin-top: 10px;
    overflow: hidden;
    color: var(--bleu-principal);
    font-size: 0.875rem;
    font-weight: var(--graisse-normale);
    text-decoration: underline solid;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  .typo-textWhite {
    color: var(--couleur-surface);
  }
</style>
