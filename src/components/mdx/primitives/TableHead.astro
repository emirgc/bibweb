---
/*
 * En-tête de tableau (MUI TableHead) : ses cellules deviennent des
 * <th scope="col">, ce que MUI faisait par contexte React.
 */
import { entetesDeColonne } from './tableau'
import { classes, fusionnerStyles } from '@/lib/styles'

interface Props {
  class?: string
  className?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { class: classe, className, style, ...reste } = Astro.props
const contenu = entetesDeColonne(Astro.slots.has('default') ? await Astro.slots.render('default') : '')
---

<thead class={classes(classe, className)} style={fusionnerStyles(style)} {...reste} set:html={contenu}></thead>
