---
/*
 * Gabarit par défaut des pages (PageTemplate de coquille-web).
 *
 * - Niveau 0-1 (accueil, /obtenir/…) : contenu pleine largeur ; le MDX gère
 *   sa propre mise en page avec SuperHero2, Section, etc.
 * - Niveau 2 et plus : bannière (superHero du frontmatter), fil d'Ariane, et
 *   à partir de 1200 px une colonne de navigation secondaire à gauche.
 *   Sous 1200 px, la même navigation devient un bloc repliable « Dans cette
 *   section » sous le fil d'Ariane. Les variantes sont rendues en HTML et
 *   basculées en CSS : plus de saut à l'hydratation comme avec useMediaQuery.
 * - Page autonome : une page de texte (.md) de niveau 1 qui n'est la racine
 *   d'aucune section (/accessibilite-web/, /service-accessibilite/). La
 *   source lui donnait une grande bannière et rien d'autre : ni fil d'Ariane
 *   ni navigation, et une moitié d'écran vide. Elle prend la mise en page du
 *   niveau 2, h1 en tête du contenu. Sa colonne de gauche est la navigation
 *   de son groupe (GROUPES_DE_PAGES, dont le titre va dans la bannière), à
 *   défaut un sommaire « Sur cette page » de ses sections, dès qu'il y en a
 *   assez pour qu'il serve.
 *
 * `lang` (frontmatter, ex. `en`) : langue du contenu. Elle va sur <html>
 * (Base), donc sur le contenu principal et la bannière ; le fil d'Ariane, la
 * navigation de section et la rétroaction, qui sont des éléments du site,
 * restent en français.
 */
import type { MarkdownHeading } from 'astro'
import { texteSansAncre } from '@/lib/ancres'
import { sansBase } from '@/lib/chemin'
import Base from './Base.astro'
import FilAriane from '@/components/coquille/FilAriane.astro'
import NavigationSecondaire from '@/components/coquille/NavigationSecondaire.astro'
import BanniereSection from '@/components/coquille/BanniereSection.astro'
import Retroaction from '@/components/coquille/Retroaction.astro'
import { LANGUE_SITE, estEnFrancais, navigationDeGroupe, niveauDe, pageParUrl, type RacineNavigation } from '@/lib/contenu'

interface Props {
  titre?: string
  description?: string
  noindex?: boolean
  niveau?: number
  superHero?: { imageName: string; title?: string; cadrage?: string }
  /** Langue du contenu ; à défaut, celle du frontmatter de la page */
  lang?: string
  /** Titres du contenu (render() d'astro:content), pour le sommaire d'une page autonome */
  titres?: MarkdownHeading[]
}

/** En dessous, un sommaire n'apprend rien qu'un coup d'œil à la page ne donne */
const SECTIONS_MIN_SOMMAIRE = 3

const url = sansBase(Astro.url.pathname)
const { titre, description, noindex, superHero, titres = [] } = Astro.props
// La route ne transmet pas (encore) la langue : on la lit dans la collection
const lang = Astro.props.lang ?? (await pageParUrl(url))?.data.lang
const langSite = estEnFrancais(lang) ? undefined : LANGUE_SITE
const niveau = Astro.props.niveau ?? niveauDe(url)
const estAccueil = url === '/'
// La rétroaction (« Cette page vous a-t-elle été utile? ») ne sert que sur
// les pages de contenu : pas sur l'accueil ni sur les pages de section de
// niveau 1 (le fichier index d'un dossier : /engagements/, /espaces/…). Les
// pages de contenu de niveau 1 (/accessibilite-web/…) la gardent.
const fichierSource = (await pageParUrl(url))?.filePath ?? ''
// Une vitrine (.yaml) est toujours une page principale
const estPagePrincipale = estAccueil || /\.ya?ml$/.test(fichierSource) || (niveau <= 1 && /(^|\/)index\.mdx?$/.test(fichierSource))
const autonome = niveau === 1 && !estPagePrincipale && fichierSource.endsWith('.md')
const section = autonome ? undefined : url.split('/').filter(Boolean)[0]
const groupe = autonome ? await navigationDeGroupe(url) : null

// Sections de la page : les titres juste sous le h1 (le plus haut des titres)
const plusHaut = Math.min(...titres.map((t) => t.depth))
const sections = titres.filter((t) => t.depth === plusHaut + 1)
const sommaire: RacineNavigation | null =
  autonome && !groupe && sections.length >= SECTIONS_MIN_SOMMAIRE
    ? { titre: 'Sur cette page', enfants: sections.map((t, i) => ({ titre: texteSansAncre(t.text), url: `#${t.slug}`, ordre: i, enfants: [] })) }
    : null
const racine = groupe ?? sommaire
const resume = sommaire?.titre
const nomColonne = sommaire ? 'Sommaire de la page' : 'Navigation de la section'
---

<Base titre={titre} description={description} noindex={noindex} niveau={niveau} lang={lang}>
  {(niveau > 1 || autonome) && superHero && <BanniereSection slot="avant-contenu" imageName={superHero.imageName} titre={groupe?.titre ?? superHero.title} cadrage={superHero.cadrage} />}
  {
    niveau > 1 || autonome ? (
      <div class="conteneur page-niveau-n">
        <aside class="colonne-navigation" aria-label={nomColonne} lang={langSite}>
          <NavigationSecondaire section={section} racine={racine} courante={url} />
        </aside>
        <div class="colonne-contenu">
          <FilAriane url={url} lang={langSite} />
          <NavigationSecondaire section={section} racine={racine} courante={url} variante="repliable" resume={resume} lang={langSite} />
          <main id="contenu-principal">
            <slot />
          </main>
          <Retroaction lang={langSite} />
        </div>
      </div>
    ) : (
      <>
        <main id="contenu-principal">
          <slot />
        </main>
        {!estPagePrincipale && (
          <div class="conteneur">
            <Retroaction lang={langSite} />
          </div>
        )}
      </>
    )
  }
</Base>

<style>
  main:focus {
    outline: none;
  }

  /* Entre la bannière et le fil d'Ariane (60 px auparavant) */
  .page-niveau-n {
    padding-block-start: var(--espace-6);
  }

  .colonne-navigation {
    display: none;
  }

  @media (min-width: 1200px) {
    .page-niveau-n {
      display: grid;
      grid-template-columns: 3fr 9fr;
      gap: var(--espace-4);
      align-items: start;
    }

    .colonne-navigation {
      display: block;
      position: sticky;
      top: calc(var(--hauteur-entete) + 1rem);
    }
  }

  /* Le premier bloc du contenu ne crée pas d'espace sous le fil d'Ariane */
  .colonne-contenu main > :global(:first-child) {
    margin-top: 0;
    padding-top: 0;
  }
</style>
