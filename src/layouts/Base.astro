---
/*
 * Squelette HTML commun à toutes les pages : <head> (SEO, partage, icônes),
 * lien d'évitement, coquille (en-tête, pied de page) et web components
 * institutionnels. Les gabarits (GabaritPage, GabaritNouvelle…) placent leur
 * contenu dans le slot par défaut.
 */
import { sansBase } from '@/lib/chemin'
import '@/styles/global.css'
// Polices préchargées : sans cela, l'échange de police au chargement fait
// passer des paragraphes sur une ligne de plus (CLS de 0,19 mesuré sur
// /conditions-utilisation/ à 900 px). Seul le sous-ensemble latin, le seul
// utilisé par le contenu, est préchargé.
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url'
import loraLatin from '@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url'
import '@/styles/animations.css'
import Entete from '@/components/coquille/Entete.astro'
import BandeauHoraires from '@/components/coquille/BandeauHoraires.astro'
import PiedDePage from '@/components/coquille/PiedDePage.astro'
import LiensRapides from '@/components/coquille/LiensRapides.astro'
import ServicesInstitutionnels from '@/components/coquille/ServicesInstitutionnels.astro'
import RetourHaut from '@/components/coquille/RetourHaut.astro'
import Recherche from '@/components/coquille/Recherche.astro'
import { LANGUE_SITE, estEnFrancais } from '@/lib/contenu'

interface Props {
  titre?: string
  description?: string
  noindex?: boolean
  /** Sans en-tête ni pied de page (pages utilitaires) */
  vierge?: boolean
  /** Niveau de page (0 = accueil) : règle la place de la bannière d'avis */
  niveau?: number
  image?: string
  /** Langue du contenu (BCP 47), si ce n'est pas le français */
  lang?: string
}

const SITE_TITRE = 'Les bibliothèques / UdeM'
const SITE_DESCRIPTION = "Site Web des Bibliothèques de l'Université de Montréal"

const { titre, description = SITE_DESCRIPTION, noindex = false, vierge = false, niveau = 0, image = '/images/logo-udem-bib.png', lang } = Astro.props
const titreComplet = titre && titre !== SITE_TITRE ? `${titre} | ${SITE_TITRE}` : SITE_TITRE
const canonique = new URL(sansBase(Astro.url.pathname), Astro.site)
const imageAbsolue = new URL(image, Astro.site)

// Page dans une autre langue : <html> (donc <title> et le contenu) prend sa
// langue, et les pièces de la coquille, qui restent en français, sont
// enveloppées dans un élément lang="fr-CA" sans boîte (display: contents :
// l'en-tête collant et les barres fixes ne voient aucune différence).
// En français, pas d'enveloppe : le DOM reste celui de toutes les pages.
const langPage = estEnFrancais(lang) ? LANGUE_SITE : lang
const Coquille = langPage === LANGUE_SITE ? Fragment : 'div'
const attributsCoquille = langPage === LANGUE_SITE ? {} : { lang: LANGUE_SITE, style: 'display: contents' }
---

<!doctype html>
<html lang={langPage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={loraLatin} as="font" type="font/woff2" crossorigin />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {(noindex || vierge) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content={SITE_TITRE} />
    <meta property="og:title" content={titre ?? SITE_TITRE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageAbsolue} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bibUdeM" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-192x192.png" />
    <meta name="theme-color" content="#0b113a" />
    <slot name="head" />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu-principal" lang={langPage === LANGUE_SITE ? undefined : LANGUE_SITE}>Aller au contenu principal</a>
    {
      vierge ? (
        <main id="contenu-principal" class="conteneur" tabindex="-1">
          <slot />
        </main>
      ) : (
        <>
          <Coquille {...attributsCoquille}>
            <ServicesInstitutionnels position="haut" niveau={niveau} />
            <Entete />
            <BandeauHoraires />
          </Coquille>
          <slot name="avant-contenu" />
          {/* Avis des pages de niveau 2 et plus : après la bannière de
              section, comme dans PageTemplate (rien sous le niveau 2) */}
          <Coquille {...attributsCoquille}>
            <ServicesInstitutionnels position="avis" niveau={niveau} />
          </Coquille>
          <slot />
          <Coquille {...attributsCoquille}>
            {/* Après le contenu : barre et languette sont fixes, seul l'ordre
                de tabulation en dépend (avant, la barre précédait le fil
                d'Ariane ; WCAG 2.4.3) */}
            <LiensRapides />
            <PiedDePage />
            <Recherche />
            <ServicesInstitutionnels position="bas" niveau={niveau} />
            <RetourHaut />
          </Coquille>
        </>
      )
    }
    {/* Apparitions au défilement : module différé, exécuté après l'analyse du
        HTML. Il ne masque que ce qui est sous la ligne de flottaison. */}
    <script>
      import '@/lib/animations'
    </script>
  </body>
</html>

